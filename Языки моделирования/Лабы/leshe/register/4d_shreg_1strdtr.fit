CHIP "4d_shreg_1strdtr"
BEGIN

    DEVICE = "EPM7032LC44-6";

    "read"                         : INPUT_PIN  = 4      ; -- LC1
    "reset"                        : INPUT_PIN  = 1      ;
    "write"                        : INPUT_PIN  = 43     ;
    "X1"                           : INPUT_PIN  = 6      ; -- LC3
    "X2"                           : INPUT_PIN  = 7      ; -- LC4
    "X3"                           : INPUT_PIN  = 8      ; -- LC5
    "X4"                           : INPUT_PIN  = 5      ; -- LC2
    "Q1"                           : OUTPUT_PIN = 36     ; -- LC22
    "Q_1"                          : OUTPUT_PIN = 40     ; -- LC18
    "Q2"                           : OUTPUT_PIN = 34     ; -- LC23
    "Q_2"                          : OUTPUT_PIN = 41     ; -- LC17
    "Q3"                           : OUTPUT_PIN = 33     ; -- LC24
    "Q_3"                          : OUTPUT_PIN = 38     ; -- LC20
    "Q4"                           : OUTPUT_PIN = 37     ; -- LC21
    "Q_4"                          : OUTPUT_PIN = 39     ; -- LC19

END;

