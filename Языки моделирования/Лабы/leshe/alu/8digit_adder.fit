    "B7"                           : INPUT_PIN  = 11     ; -- LC7
    "B8"                           : INPUT_PIN  = 12     ; -- LC8
    "C"                            : OUTPUT_PIN = 28     ; -- LC28
    "S1"                           : OUTPUT_PIN = 25     ; -- LC31
    "S2"                           : OUTPUT_PIN = 24     ; -- LC32
    "S3"                           : OUTPUT_PIN = 5      ; -- LC2
    "S4"                           : OUTPUT_PIN = 4      ; -- LC1
    "S5"                           : OUTPUT_PIN = 26     ; -- LC30
    "S6"                           : OUTPUT_PIN = 29     ; -- LC27
    "S7"                           : OUTPUT_PIN = 31     ; -- LC26
    "S8"                           : OUTPUT_PIN = 41     ; -- LC17
    "|7483:27|~44~1"               : LOCATION   = LC20   ; -- PIN 38  -- |7483:27|S3~1
    "|7483:27|~44~2"               : LOCATION   = LC24   ; -- PIN 33  -- |7483:27|S3~2
    "|7483:27|~45~1"               : LOCATION   = LC25   ; -- PIN 32  -- |7483:27|S4~1
    "|7483:27|~45~2"               : LOCATION   = LC29   ; -- PIN 27  -- |7483:27|S4~2
    "|7483:27|~45~3"               : LOCATION   = LC18   ; -- PIN 40  -- |7483:27|S4~3
    "|7483:27|~45~4"               : LOCATION   = LC19   ; -- PIN 39  -- |7483:27|S4~4
    "|7483:28|~2~1"                : LOCATION   = LC21   ; -- PIN 37
    "|7483:28|~45~1"               : LOCATION   = LC22   ; -- PIN 36  -- |7483:28|S4~1
    "|7483:28|~45~2"               : LOCATION   = LC23   ; -- PIN 34  -- |7483:28|S4~2
    "|7483:28|~45~3"               : LOCATION   = LC12   ; -- PIN 17  -- |7483:28|S4~3
    "|7483:28|:83"                 : LOCATION   = LC16   ; -- PIN 21  -- |7483:28|C4

END;

