CHIP "8digit_adder"
BEGIN

    DEVICE = "EPM7032LC44-6";

    "A1"                           : INPUT_PIN  = 40     ; -- LC18
    "A2"                           : INPUT_PIN  = 9      ; -- LC6
    "A3"                           : INPUT_PIN  = 8      ; -- LC5
    "A4"                           : INPUT_PIN  = 21     ; -- LC16
    "A5"                           : INPUT_PIN  = 20     ; -- LC15
    "A6"                           : INPUT_PIN  = 19     ; -- LC14
    "A7"                           : INPUT_PIN  = 18     ; -- LC13
