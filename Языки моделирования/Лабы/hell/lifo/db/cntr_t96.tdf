FUNCTION stratix_lcell (aclr, aload, cin, clk, dataa, datab, datac, datad, ena, inverta, regcascin, sclr, sload)
WITH ( 	cin_used,	lut_mask,	operation_mode,	output_mode,	register_cascade_mode,	sum_lutc_input,	synch_mode) 
RETURNS ( combout, cout, regout);

--synthesis_resources = lut 3 
SUBDESIGN cntr_t96
( 
	aclr	:	input;
	clock	:	input;
	cout	:	output;
	q[2..0]	:	output;
	updown	:	input;
) 
VARIABLE 
	counter_cella0 : stratix_lcell
		WITH (
			cin_used = "false",
			lut_mask = "5599",
			operation_mode = "arithmetic",
			synch_mode = "on"
		);
	counter_cella1 : stratix_lcell
		WITH (
			cin_used = "true",
			lut_mask = "5A90",
			operation_mode = "arithmetic",
			sum_lutc_input = "cin",
			synch_mode = "on"
		);
	counter_cella2 : stratix_lcell
		WITH (
			cin_used = "true",
			lut_mask = "5A90",
			operation_mode = "arithmetic",
			sum_lutc_input = "cin",
			synch_mode = "on"
		);
	a_val[2..0]	: WIRE;
	aclr_actual	: WIRE;
	aset_node	: WIRE;
	clk_en	: NODE;
	cnt_en	: NODE;
	data[2..0]	: NODE;
	s_val[2..0]	: WIRE;
	safe_q[2..0]	: WIRE;
	sclr	: NODE;
	sload	: NODE;
	sset	: NODE;
	sset_node	: WIRE;
	time_to_clear	: WIRE;
	updownDir	: WIRE;

BEGIN 
	counter_cella[2..0].aclr = aclr_actual;
	counter_cella[2..0].aload = B"000";
	counter_cella[1].cin = counter_cella[0].cout;
	counter_cella[2].cin = counter_cella[1].cout;
	counter_cella[2..0].clk = clock;
	counter_cella[2..0].dataa = safe_q[];
	counter_cella[2..0].datab = updownDir;
	counter_cella[2..0].datac = ((sset & s_val[]) # ((! sset) & data[]));
	counter_cella[2..0].ena = (clk_en & (((cnt_en # sclr) # sset) # sload));
	counter_cella[2..0].sclr = sclr;
	counter_cella[2..0].sload = (sset # sload);
	a_val[] = B"111";
	aclr_actual = aclr;
	aset_node = B"0";
	clk_en = VCC;
	cnt_en = VCC;
	cout = counter_cella[2].cout;
	data[] = GND;
	q[] = safe_q[];
	s_val[] = B"111";
	safe_q[] = counter_cella[2..0].regout;
	sclr = GND;
	sload = GND;
	sset = GND;
	sset_node = B"0";
	time_to_clear = B"0";
	updownDir = updown;
END;
--VALID FILE
