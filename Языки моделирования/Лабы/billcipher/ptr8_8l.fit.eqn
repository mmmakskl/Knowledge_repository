--B1L5 is cip8_3l:c|g~76 at LC_X1_Y1_N6
--operation mode is normal

B1L5 = r[0] # r[3] # r[2] # r[1];


--B1L6 is cip8_3l:c|process0~5 at LC_X1_Y1_N0
--operation mode is normal

B1L6 = r[5] # r[6] # r[7] # r[4];


--B1L3 is cip8_3l:c|a[1]~290 at LC_X1_Y1_N9
--operation mode is normal

B1L3 = !r[5] & !r[4] & (r[3] # r[2]);


--B1L4 is cip8_3l:c|a[1]~291 at LC_X1_Y1_N8
--operation mode is normal

B1L4 = r[6] # r[7] # B1L3;


--B1L1 is cip8_3l:c|a[0]~292 at LC_X1_Y1_N1
--operation mode is normal

B1L1 = !r[4] & (r[3] # r[1] & !r[2]);


--B1L2 is cip8_3l:c|a[0]~293 at LC_X1_Y1_N2
--operation mode is normal

B1L2 = r[7] # !r[6] & (r[5] # B1L1);


--A1L31 is q~184 at LC_X1_Y1_N3
--operation mode is normal

A1L31 = A1L91 & (!B1L4 & !B1L2 # !ei);


--A1L41 is q~185 at LC_X1_Y1_N4
--operation mode is normal

A1L41 = !B1L4 & A1L91 & ei & B1L2;


--A1L51 is q~186 at LC_X2_Y1_N8
--operation mode is normal

A1L51 = !r[7] & ei & r[5] & !r[6];


--A1L61 is q~187 at LC_X2_Y1_N7
--operation mode is normal

A1L61 = !r[7] & ei & (r[6]);


--A1L71 is q~188 at LC_X2_Y1_N4
--operation mode is normal

A1L71 = ei & (r[7]);


--A1L81 is q~189 at LC_X1_Y1_N7
--operation mode is normal

A1L81 = !B1L4 & B1L6 & ei & !B1L2;


--A1L91 is q~190 at LC_X1_Y1_N5
--operation mode is normal

A1L91 = B1L5 & ei & !B1L6;


--A1L02 is q~191 at LC_X2_Y1_N2
--operation mode is normal

A1L02 = !r[3] & ei & r[2] & A1L11;


--A1L11 is q~160 at LC_X2_Y1_N6
--operation mode is normal

A1L11 = !r[6] & !r[4] & !r[5] & !r[7];


--A1L12 is q~192 at LC_X2_Y1_N9
--operation mode is normal

A1L12 = r[3] & ei & A1L21 & !r[7];


--A1L21 is q~175 at LC_X2_Y1_N5
--operation mode is normal

A1L21 = !r[6] & (!r[5] & !r[4]);


--ei is ei at PIN_AA21
--operation mode is input

ei = INPUT();


--r[2] is r[2] at PIN_Y20
--operation mode is input

r[2] = INPUT();


--r[3] is r[3] at PIN_W20
--operation mode is input

r[3] = INPUT();


--r[0] is r[0] at PIN_Y21
--operation mode is input

r[0] = INPUT();


--r[1] is r[1] at PIN_W21
--operation mode is input

r[1] = INPUT();


--r[7] is r[7] at PIN_AB19
--operation mode is input

r[7] = INPUT();


--r[6] is r[6] at PIN_U20
--operation mode is input

r[6] = INPUT();


--r[4] is r[4] at PIN_W19
--operation mode is input

r[4] = INPUT();


--r[5] is r[5] at PIN_AA20
--operation mode is input

r[5] = INPUT();


--q[0] is q[0] at PIN_U19
--operation mode is output

q[0] = OUTPUT(A1L31);


--q[1] is q[1] at PIN_W22
--operation mode is output

q[1] = OUTPUT(A1L41);


--q[2] is q[2] at PIN_AA18
