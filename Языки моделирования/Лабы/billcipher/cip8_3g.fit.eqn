--A1L8 is inst23~76 at LC_X26_Y12_N5
--operation mode is normal

A1L8 = EI & (r7 # !r6 & r5);


--A1L9 is inst23~77 at LC_X26_Y12_N1
--operation mode is normal

A1L9 = !r4 & (r3 # r1 & !r2);


--A1L01 is inst23~78 at LC_X26_Y12_N2
--operation mode is normal

A1L01 = A1L8 # EI & !r6 & A1L9;


--A1L61 is inst~23 at LC_X25_Y12_N9
--operation mode is normal

A1L61 = !r3 & !r2;


--A1L11 is inst24~53 at LC_X26_Y12_N4
--operation mode is normal

A1L11 = EI & (r6 # r7 # !A1L21);


--A1L71 is inst~24 at LC_X26_Y12_N7
--operation mode is normal

A1L71 = !r4 & !r6 & !r7 & !r5;


--A1L31 is inst25~18 at LC_X26_Y12_N9
--operation mode is normal

A1L31 = EI & (!A1L71);


--inst is inst at LC_X26_Y12_N0
--operation mode is normal

inst = r1 # r0 # !A1L61 # !A1L71;


--inst26 is inst26 at LC_X26_Y12_N6
--operation mode is normal

inst26 = EI & (!inst);


--inst27 is inst27 at LC_X26_Y12_N8
--operation mode is normal

inst27 = EI & (inst);


--A1L21 is inst24~54 at LC_X26_Y12_N3
--operation mode is normal

A1L21 = r5 # r4 # !r3 & !r2;


--EI is EI at PIN_72
--operation mode is input

EI = INPUT();


--r7 is r7 at PIN_85
--operation mode is input

r7 = INPUT();


--r5 is r5 at PIN_71
--operation mode is input

r5 = INPUT();


--r6 is r6 at PIN_74
--operation mode is input

r6 = INPUT();


--r3 is r3 at PIN_79
--operation mode is input

r3 = INPUT();


--r1 is r1 at PIN_68
--operation mode is input

r1 = INPUT();


--r2 is r2 at PIN_78
--operation mode is input

r2 = INPUT();


--r4 is r4 at PIN_69
--operation mode is input

r4 = INPUT();


--r0 is r0 at PIN_75
--operation mode is input

r0 = INPUT();


--a0 is a0 at PIN_84
--operation mode is output

a0 = OUTPUT(A1L01);


--a1 is a1 at PIN_77
--operation mode is output

a1 = OUTPUT(A1L11);


--a2 is a2 at PIN_76
--operation mode is output

a2 = OUTPUT(A1L31);


--EO is EO at PIN_73
--operation mode is output

EO = OUTPUT(inst26);


--G is G at PIN_70
--operation mode is output

G = OUTPUT(inst27);




