--C1L1 is cip8_3g:inst1|inst23~131 at LC_X52_Y2_N4
--operation mode is normal

C1L1 = EI & r7;


--B1L31 is dc3g:inst|inst11~5 at LC_X52_Y1_N3
--operation mode is normal

B1L31 = r6 # r7 # !EI # !r5;


--B1L41 is dc3g:inst|inst17~17 at LC_X52_Y1_N6
--operation mode is normal

B1L41 = r7 # !EI # !r6;


--B1L8 is dc3g:inst|inst8~36 at LC_X52_Y1_N7
--operation mode is normal

B1L8 = r4 # r6 # B1L7 # !EI;


--B1L7 is dc3g:inst|inst8~24 at LC_X52_Y1_N9
--operation mode is normal

B1L7 = r3 # r7 # r5 # !r2;


--B1_inst9 is dc3g:inst|inst9 at LC_X52_Y1_N2
--operation mode is normal

B1_inst9 = r4 # r6 # B1L01 # !EI;


--B1L01 is dc3g:inst|inst9~13 at LC_X52_Y1_N1
--operation mode is normal

B1L01 = r7 # r5 # !r3;


--B1L11 is dc3g:inst|inst10~23 at LC_X52_Y1_N8
--operation mode is normal

B1L11 = r7 # r5;


--B1L21 is dc3g:inst|inst10~29 at LC_X52_Y1_N0
--operation mode is normal

B1L21 = r6 # B1L11 # !EI # !r4;


--B1_inst5 is dc3g:inst|inst5 at LC_X52_Y1_N4
--operation mode is normal

B1_inst5 = EI & (r4 # r6 # B1L2);


--B1L2 is dc3g:inst|inst5~29 at LC_X52_Y2_N8
--operation mode is normal

B1L2 = r7 # r5 # B1L3 # !r0;


--B1L3 is dc3g:inst|inst5~32 at LC_X52_Y2_N6
--operation mode is normal

B1L3 = r3 # r1 # r2;


--B1L6 is dc3g:inst|inst6~15 at LC_X52_Y2_N2
--operation mode is normal

B1L6 = r3 # r2;


--B1_inst6 is dc3g:inst|inst6 at LC_X52_Y1_N5
--operation mode is normal

B1_inst6 = r4 # r6 # B1L5 # !EI;


--B1L5 is dc3g:inst|inst6~12 at LC_X52_Y2_N5
--operation mode is normal

B1L5 = r7 # r5 # B1L6 # !r1;


--EI is EI at PIN_W3
--operation mode is input

EI = INPUT();


--r6 is r6 at PIN_Y3
--operation mode is input

r6 = INPUT();


--r4 is r4 at PIN_AA4
--operation mode is input

r4 = INPUT();


--r5 is r5 at PIN_T5
--operation mode is input

r5 = INPUT();


--r7 is r7 at PIN_W1
--operation mode is input

r7 = INPUT();


--r0 is r0 at PIN_T4
--operation mode is input

r0 = INPUT();


--r1 is r1 at PIN_W2
--operation mode is input

r1 = INPUT();


--r2 is r2 at PIN_V4
--operation mode is input

r2 = INPUT();


--r3 is r3 at PIN_T7
--operation mode is input

r3 = INPUT();


--q0 is q0 at PIN_Y4
--operation mode is output

q0 = OUTPUT(!B1_inst5);


--q1 is q1 at PIN_N7
--operation mode is output

q1 = OUTPUT(!B1_inst6);


--q2 is q2 at PIN_Y2
--operation mode is output

q2 = OUTPUT(!B1L8);


--q3 is q3 at PIN_AA2
--operation mode is output

q3 = OUTPUT(!B1_inst9);


--q4 is q4 at PIN_V3
--operation mode is output

q4 = OUTPUT(!B1L21);


--q5 is q5 at PIN_AA3
--operation mode is output

q5 = OUTPUT(!B1L31);


--q6 is q6 at PIN_W4
--operation mode is output

q6 = OUTPUT(!B1L41);


--q7 is q7 at PIN_U5
