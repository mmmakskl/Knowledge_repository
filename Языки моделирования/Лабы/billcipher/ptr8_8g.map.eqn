--B1L2 is dc3g:inst|inst5~29
--operation mode is normal

B1L2 = B1L3 # r7 # r5 # !r0;


--B1L3 is dc3g:inst|inst5~32
--operation mode is normal

B1L3 = r3 # r2 # r1;


--B1L6 is dc3g:inst|inst6~15
--operation mode is normal

B1L6 = r3 # r2;


--B1_inst6 is dc3g:inst|inst6
--operation mode is normal

B1_inst6 = B1L5 # r4 # r6 # !EI;


--B1L5 is dc3g:inst|inst6~12
--operation mode is normal

B1L5 = B1L6 # r7 # r5 # !r1;


--EI is EI
--operation mode is input

EI = INPUT();


--r6 is r6
--operation mode is input

r6 = INPUT();


--r4 is r4
--operation mode is input

r4 = INPUT();


--r5 is r5
--operation mode is input

