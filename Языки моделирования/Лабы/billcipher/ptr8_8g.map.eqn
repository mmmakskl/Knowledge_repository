--C1L1 is cip8_3g:inst1|inst23~131
--operation mode is normal

C1L1 = EI & r7;


--B1L31 is dc3g:inst|inst11~5
--operation mode is normal

B1L31 = r6 # r7 # !r5 # !EI;


--B1L41 is dc3g:inst|inst17~17
