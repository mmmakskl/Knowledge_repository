--A1L4 is process0~144 at LC_X52_Y1_N2
--operation mode is normal

A1L4 = a0 & (a1 # x1) # !a0 & x0 & !a1;


--A1L5 is process0~145 at LC_X52_Y1_N5
--operation mode is normal

A1L5 = A1L4 & (x3 # !a1) # !A1L4 & (a1 & x2);


--q$latch is q$latch at LC_X52_Y1_N4
--operation mode is normal

q$latch = A1L5 & e;


--x2 is x2 at PIN_W4
--operation mode is input

x2 = INPUT();


--a1 is a1 at PIN_AA2
--operation mode is input

a1 = INPUT();


--x1 is x1 at PIN_AA3
--operation mode is input

x1 = INPUT();


--a0 is a0 at PIN_Y3
--operation mode is input

a0 = INPUT();


--x0 is x0 at PIN_T7
--operation mode is input

x0 = INPUT();


--x3 is x3 at PIN_W3
--operation mode is input

x3 = INPUT();


--e is e at PIN_V3
--operation mode is input

e = INPUT();


--q is q at PIN_V4
--operation mode is output

q = OUTPUT(q$latch);



