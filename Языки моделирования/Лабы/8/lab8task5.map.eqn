--B1L1 is 74153:1|9~168
--operation mode is normal

B1L1 = a & 1c3 # !a & (1c2);


--B1L2 is 74153:1|9~169
--operation mode is normal

B1L2 = a & 1c1 # !a & (1c0);


--B1L3 is 74153:1|9~170
--operation mode is normal

B1L3 = !1gn & (b & B1L1 # !b & (B1L2));


--B1L4 is 74153:1|10~161
--operation mode is normal

B1L4 = a & 2c3 # !a & (2c2);


--B1L5 is 74153:1|10~162
--operation mode is normal

B1L5 = a & 2c1 # !a & (2c0);


--B1L6 is 74153:1|10~163
--operation mode is normal

B1L6 = !2gn & (b & B1L4 # !b & (B1L5));


--1c3 is 1c3
--operation mode is input

1c3 = INPUT();


--1c2 is 1c2
--operation mode is input

1c2 = INPUT();


--a is a
--operation mode is input

a = INPUT();


--1c1 is 1c1
--operation mode is input

1c1 = INPUT();


--1c0 is 1c0
--operation mode is input

1c0 = INPUT();


--b is b
--operation mode is input

b = INPUT();


--1gn is 1gn
--operation mode is input

1gn = INPUT();


--2c3 is 2c3
--operation mode is input

2c3 = INPUT();


--2c2 is 2c2
--operation mode is input

2c2 = INPUT();


--2c1 is 2c1
--operation mode is input

2c1 = INPUT();


--2c0 is 2c0
--operation mode is input

2c0 = INPUT();


--2gn is 2gn
--operation mode is input

2gn = INPUT();


--1y is 1y
--operation mode is output

1y = OUTPUT(B1L3);


--2y is 2y
--operation mode is output

2y = OUTPUT(B1L6);


