--A1L2 is 11~19 at LC_X52_Y1_N5
--operation mode is normal

A1L2 = a0 & (a1 # !x1) # !a0 & !x0 & (!a1);


--A1L3 is 11~20 at LC_X52_Y1_N2
--operation mode is normal

A1L3 = A1L2 & (!a1 # !x3) # !A1L2 & (!x2 & a1);


--9 is 9 at LC_X52_Y1_N4
--operation mode is normal

9 = e & !A1L3;


--e is e at PIN_W4
--operation mode is input

e = INPUT();


--x2 is x2 at PIN_AA2
--operation mode is input

x2 = INPUT();


--a1 is a1 at PIN_AA3
--operation mode is input

a1 = INPUT();


--x1 is x1 at PIN_Y3
--operation mode is input

x1 = INPUT();


--a0 is a0 at PIN_T7
--operation mode is input

a0 = INPUT();


--x0 is x0 at PIN_W3
--operation mode is input

x0 = INPUT();


--x3 is x3 at PIN_V3
--operation mode is input

x3 = INPUT();


--q is q at PIN_V4
--operation mode is output

q = OUTPUT(9);



