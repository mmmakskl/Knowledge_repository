--B1L1 is lab8task1:1|9~86 at LC_X36_Y30_N2
--operation mode is normal

B1L1 = e & (Y2 & (!Y1 # !Y3) # !Y2 & Y3);


--e is e at PIN_E9
--operation mode is input

e = INPUT();


--Y2 is Y2 at PIN_F9
--operation mode is input

Y2 = INPUT();


--Y3 is Y3 at PIN_C9
--operation mode is input

Y3 = INPUT();


--Y1 is Y1 at PIN_D9
--operation mode is input

Y1 = INPUT();


--Q is Q at PIN_L7
--operation mode is output

Q = OUTPUT(B1L1);



