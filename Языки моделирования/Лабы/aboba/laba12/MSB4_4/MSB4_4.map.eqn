--B1L5 is 7483:inst1|42~39
--operation mode is normal

B1L5 = X0 $ Y0 $ (A0 & B0);


--B1L4 is 7483:inst1|18~82
--operation mode is normal

B1L4 = X0 & !Y0 & (!B0 # !A0) # !X0 & (!Y0 # !B0 # !A0);


--B1L6 is 7483:inst1|43~113
--operation mode is normal

B1L6 = B1L4 $ X1 $ (B0 & A1);


