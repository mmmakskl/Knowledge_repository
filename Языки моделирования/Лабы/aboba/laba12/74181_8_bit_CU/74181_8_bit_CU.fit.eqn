--C1L01 is 74181:inst1|63~147 at LC_X24_Y1_N9
--operation mode is normal

C1L01 = !C1L1 & !C1L5 # !C1L2;


--C1_82 is 74181:inst1|82 at LC_X24_Y1_N3
--operation mode is normal

C1_82 = C1L6 $ C1L3 $ (M # !C1L01);


--C1L7 is 74181:inst1|51~17 at LC_X25_Y1_N6
--operation mode is normal

C1L7 = A3 # B3 & S0 # !B3 & (S1);


--C1L8 is 74181:inst1|52~51 at LC_X25_Y1_N2
--operation mode is normal

C1L8 = A3 & (B3 & S3 # !B3 & (S2));


--C1L41 is 74181:inst1|75~133 at LC_X24_Y1_N8
--operation mode is normal

C1L41 = !C1L1 & !C1L5;


--C1L31 is 74181:inst1|74~183 at LC_X24_Y1_N7
--operation mode is normal

C1L31 = !C1L6 & (C1L41 # !C1L2) # !C1L3;


--C1_77 is 74181:inst1|77 at LC_X24_Y1_N6
--operation mode is normal

C1_77 = C1L7 $ C1L8 $ (M # !C1L31);


--C2L1 is 74181:inst2|43~10 at LC_X22_Y1_N5
--operation mode is normal

C2L1 = A4 # B4 & (S0) # !B4 & S1;


--C2L4 is 74181:inst2|46~51 at LC_X22_Y1_N8
--operation mode is normal

C2L4 = A4 & (B4 & S3 # !B4 & (S2));


--C1L11 is 74181:inst1|63~148 at LC_X24_Y1_N2
--operation mode is normal

C1L11 = !C1L6 & (!C1L1 & !C1L5 # !C1L2);


--C1L21 is 74181:inst1|63~149 at LC_X24_Y1_N4
--operation mode is normal

C1L21 = !C1L8 & (C1L11 # !C1L3) # !C1L7;


--C2_80 is 74181:inst2|80 at LC_X22_Y1_N7
--operation mode is normal

C2_80 = C2L1 $ C2L4 $ (M # !C1L21);


--C2L2 is 74181:inst2|44~10 at LC_X22_Y1_N0
--operation mode is normal

C2L2 = A5 # B5 & (S0) # !B5 & S1;


--C2L5 is 74181:inst2|47~51 at LC_X22_Y1_N2
--operation mode is normal

C2L5 = A5 & (B5 & (S3) # !B5 & S2);


--C2L61 is 74181:inst2|81~102 at LC_X22_Y1_N3
--operation mode is normal

C2L61 = C2L1 & (C2L4 # !C1L21);


--C2L71 is 74181:inst2|81~103 at LC_X22_Y1_N4
--operation mode is normal

C2L71 = C2L5 $ C2L2 $ (C2L61 # M);


--C2L01 is 74181:inst2|73~3 at LC_X22_Y1_N9
--operation mode is normal

C2L01 = !C2L4 & !M & C1L21 & !C2L5;


--C2L31 is 74181:inst2|75~5 at LC_X22_Y1_N6
--operation mode is normal

C2L31 = !M & (!C2L5 & !C2L1 # !C2L2);


--C2L3 is 74181:inst2|45~10 at LC_X23_Y1_N6
--operation mode is normal

C2L3 = A6 # B6 & (S0) # !B6 & S1;


--C2L6 is 74181:inst2|48~51 at LC_X25_Y1_N8
--operation mode is normal

C2L6 = A6 & (B6 & (S3) # !B6 & S2);


--C2_82 is 74181:inst2|82 at LC_X23_Y1_N0
--operation mode is normal

C2_82 = C2L6 $ C2L3 $ (!C2L31 & !C2L01);


--C2L21 is 74181:inst2|74~23 at LC_X23_Y1_N9
--operation mode is normal

C2L21 = !M & (!C2L2 & !C2L6 # !C2L3);


--C2L9 is 74181:inst2|72~86 at LC_X22_Y1_N1
--operation mode is normal

C2L9 = !M & !C2L1 & !C2L5;


--C2_74 is 74181:inst2|74 at LC_X23_Y1_N7
--operation mode is normal

C2_74 = C2L21 # !C2L6 & (C2L9 # C2L01);


--C2L7 is 74181:inst2|51~10 at LC_X23_Y1_N5
--operation mode is normal

C2L7 = A7 # B7 & (S0) # !B7 & S1;


--C2L8 is 74181:inst2|52~51 at LC_X23_Y1_N1
--operation mode is normal

C2L8 = B7 & (S3) # !B7 & S2;


--C2_77 is 74181:inst2|77 at LC_X23_Y1_N2
--operation mode is normal

C2_77 = C2L7 $ C2_74 $ (!C2L8 # !A7);


--C1_83 is 74181:inst1|83 at LC_X23_Y1_N8
--operation mode is normal

C1_83 = C1_82 & !C1_53 & C1_77 & C1L61;


--C2L91 is 74181:inst2|83~14 at LC_X23_Y1_N3
--operation mode is normal

C2L91 = C2_80 & C2_82;


--inst7 is inst7 at LC_X23_Y1_N4
--operation mode is normal

inst7 = C1_83 # C2L71 & C2L91 & C2_77;


