--C1L1 is 74181:inst1|43~10 at LC_X25_Y1_N9
--operation mode is normal

C1L1 = A0 # B0 & S0 # !B0 & (S1);


--C1L4 is 74181:inst1|46~51 at LC_X25_Y1_N4
--operation mode is normal

C1L4 = B0 & S3 # !B0 & (S2);


--C1_53 is 74181:inst1|53 at LC_X25_Y1_N5
--operation mode is normal

C1_53 = C1L1 $ (A0 & C1L4);


--C1L2 is 74181:inst1|44~16 at LC_X24_Y1_N0
--operation mode is normal

C1L2 = A1 # B1 & S0 # !B1 & (S1);


--C1L5 is 74181:inst1|47~51 at LC_X24_Y1_N1
--operation mode is normal

C1L5 = A1 & (B1 & (S3) # !B1 & S2);


--C1L61 is 74181:inst1|81~114 at LC_X24_Y1_N5
--operation mode is normal

C1L61 = C1L5 $ C1L2 $ (M # C1L1);


--C1L3 is 74181:inst1|45~13 at LC_X25_Y1_N3
--operation mode is normal

C1L3 = A2 # B2 & S0 # !B2 & (S1);


--C1L6 is 74181:inst1|48~51 at LC_X25_Y1_N7
