--B1L4 is 7483:inst|27~1
--operation mode is normal

B1L4 = X1 $ Y1;


--B1L5 is 7483:inst|43~39
--operation mode is normal

B1L5 = Y2 $ X2 $ (X1 & Y1);


--B1L1 is 7483:inst|1~199
--operation mode is normal

B1L1 = Y2 & !X2 & (!Y1 # !X1) # !Y2 & (!X2 # !Y1 # !X1);


--B1_44 is 7483:inst|44
--operation mode is normal

B1_44 = B1L1 $ Y3 $ X3;


--B1L2 is 7483:inst|1~200
--operation mode is normal

B1L2 = B1L1 & (!X3 # !Y3) # !B1L1 & (!Y3 & !X3);


--B1_45 is 7483:inst|45
--operation mode is normal

B1_45 = B1L2 $ Y4 $ X4;


--B1L3 is 7483:inst|2~77
--operation mode is normal

B1L3 = B1L2 & (!X4 # !Y4) # !B1L2 & (!Y4 & !X4);


--B2_42 is 7483:inst1|42
--operation mode is normal

B2_42 = B1L3 $ Y5 $ !X5;


--A1L32 is Y5~36
--operation mode is normal

A1L32 = !Y5 & !X5;


--B2L5 is 7483:inst1|18~44
--operation mode is normal

B2L5 = B1L3 & (!X5 # !Y5);


--B2_43 is 7483:inst1|43
--operation mode is normal

B2_43 = Y6 $ X6 $ (A1L32 # B2L5);


--B2L01 is 7483:inst1|51~59
--operation mode is normal

B2L01 = Y6 & !X6 & (A1L32 # B2L5) # !Y6 & (A1L32 # B2L5 # !X6);


--B2_44 is 7483:inst1|44
--operation mode is normal

B2_44 = B2L01 $ Y7 $ X7;


--B2L1 is 7483:inst1|1~53
--operation mode is normal

B2L1 = Y6 & (X6 # Y7 & X7) # !Y6 & (Y7 & X7);


--B2L2 is 7483:inst1|1~54
--operation mode is normal

B2L2 = !B2L1 & (B1L3 & (!X5 # !Y5) # !B1L3 & !Y5 & !X5);


--B2L3 is 7483:inst1|1~55
--operation mode is normal

B2L3 = Y7 & !Y6 & !X6 & !X7 # !Y7 & (!Y6 & !X6 # !X7);


--B2_45 is 7483:inst1|45
--operation mode is normal

B2_45 = Y8 $ X8 $ (B2L2 # B2L3);


--B2L4 is 7483:inst1|2~69
--operation mode is normal

B2L4 = Y8 & !X8 & (B2L2 # B2L3) # !Y8 & (B2L2 # B2L3 # !X8);


--X1 is X1
--operation mode is input

X1 = INPUT();


--Y1 is Y1
--operation mode is input

Y1 = INPUT();


--Y2 is Y2
--operation mode is input

Y2 = INPUT();


--X2 is X2
--operation mode is input

X2 = INPUT();


--Y3 is Y3
--operation mode is input

Y3 = INPUT();


--X3 is X3
--operation mode is input

X3 = INPUT();


--Y4 is Y4
--operation mode is input

Y4 = INPUT();


--X4 is X4
--operation mode is input

X4 = INPUT();


--Y5 is Y5
--operation mode is input

Y5 = INPUT();


--X5 is X5
--operation mode is input

X5 = INPUT();


--Y6 is Y6
--operation mode is input

Y6 = INPUT();


--X6 is X6
--operation mode is input

X6 = INPUT();


--Y7 is Y7
--operation mode is input

Y7 = INPUT();


--X7 is X7
--operation mode is input

X7 = INPUT();


--Y8 is Y8
--operation mode is input

Y8 = INPUT();


--X8 is X8
--operation mode is input

X8 = INPUT();


--S1 is S1
--operation mode is output

S1 = OUTPUT(B1L4);


--S2 is S2
--operation mode is output

S2 = OUTPUT(B1L5);


--S3 is S3
--operation mode is output

S3 = OUTPUT(!B1_44);


--S4 is S4
--operation mode is output

S4 = OUTPUT(!B1_45);


--S5 is S5
--operation mode is output

S5 = OUTPUT(B2_42);


--S6 is S6
--operation mode is output

S6 = OUTPUT(!B2_43);


--S7 is S7
--operation mode is output

S7 = OUTPUT(!B2_44);


--S8 is S8
--operation mode is output

S8 = OUTPUT(!B2_45);


--C4 is C4
--operation mode is output

C4 = OUTPUT(!B2L4);


