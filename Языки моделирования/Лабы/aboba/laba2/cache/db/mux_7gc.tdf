--synthesis_resources = lut 3 
SUBDESIGN mux_7gc
( 
	data[5..0]	:	input;
	result[2..0]	:	output;
	sel[0..0]	:	input;
) 
VARIABLE 
	result_node[2..0]	: WIRE;
	sel_node[0..0]	: WIRE;
	w_data18w[1..0]	: WIRE;
	w_data30w[1..0]	: WIRE;
	w_data4w[1..0]	: WIRE;
	w_result11w	: WIRE;
	w_result19w	: WIRE;
	w_result25w	: WIRE;
	w_result31w	: WIRE;
	w_result37w	: WIRE;
	w_result5w	: WIRE;

BEGIN 
	result[] = result_node[];
	result_node[] = ( w_result31w, w_result19w, w_result5w);
	sel_node[] = ( sel[0..0]);
	w_data18w[] = ( data[4..4], data[1..1]);
	w_data30w[] = ( data[5..5], data[2..2]);
	w_data4w[] = ( data[3..3], data[0..0]);
	w_result11w = ((sel_node[] & w_data4w[1..1]) # ((! sel_node[]) & w_data4w[0..0]));
	w_result19w = w_result25w;
	w_result25w = ((sel_node[] & w_data18w[1..1]) # ((! sel_node[]) & w_data18w[0..0]));
	w_result31w = w_result37w;
	w_result37w = ((sel_node[] & w_data30w[1..1]) # ((! sel_node[]) & w_data30w[0..0]));
	w_result5w = w_result11w;
END;
--VALID FILE
