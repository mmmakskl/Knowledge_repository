--A1L2 is reduce_or~161 at LC_X1_Y1_N9
--operation mode is normal

A1L2 = X[3] & !X[6] & !X[2] & !X[7] # !X[3] & (X[6] & !X[2] & !X[7] # !X[6] & (X[2] $ X[7]));


--A1L1 is reduce_or~159 at LC_X1_Y1_N4
--operation mode is normal

A1L1 = A1L2 & (!X[1]);


--A1L7 is reduce_or~186 at LC_X1_Y1_N5
--operation mode is normal

A1L7 = !X[4] & !X[0] & !X[5] & A1L1;


--A1L4 is reduce_or~171 at LC_X1_Y1_N8
--operation mode is normal

A1L4 = X[7] & !X[5] & !X[3] & !X[1] # !X[7] & (X[5] & !X[3] & !X[1] # !X[5] & (X[3] $ X[1]));


--A1L3 is reduce_or~169 at LC_X1_Y1_N2
--operation mode is normal

A1L3 = !X[2] & A1L4;


--A1L8 is reduce_or~187 at LC_X1_Y1_N3
--operation mode is normal

A1L8 = !X[4] & !X[0] & !X[6] & A1L3;


--A1L6 is reduce_or~181 at LC_X1_Y1_N1
--operation mode is normal

A1L6 = X[4] & !X[5] & !X[6] & !X[7] # !X[4] & (X[5] & !X[6] & !X[7] # !X[5] & (X[6] $ X[7]));


--A1L5 is reduce_or~179 at LC_X1_Y1_N6
--operation mode is normal

A1L5 = A1L6 & !X[1];


--A1L9 is reduce_or~188 at LC_X1_Y1_N7
--operation mode is normal

A1L9 = !X[2] & !X[0] & !X[3] & A1L5;


--X[7] is X[7] at PIN_Y21
--operation mode is input

X[7] = INPUT();


--X[5] is X[5] at PIN_U19
--operation mode is input

X[5] = INPUT();


--X[0] is X[0] at PIN_U20
--operation mode is input

X[0] = INPUT();


--X[6] is X[6] at PIN_AA21
--operation mode is input

X[6] = INPUT();


--X[1] is X[1] at PIN_Y20
--operation mode is input

X[1] = INPUT();


--X[4] is X[4] at PIN_W19
--operation mode is input

X[4] = INPUT();


--X[3] is X[3] at PIN_T18
--operation mode is input

X[3] = INPUT();


--X[2] is X[2] at PIN_W20
--operation mode is input

X[2] = INPUT();


--Y[0] is Y[0] at PIN_W22
--operation mode is output

Y[0] = OUTPUT(A1L8);


--Y[1] is Y[1] at PIN_AA20
--operation mode is output

Y[1] = OUTPUT(A1L7);


--Y[2] is Y[2] at PIN_W21
--operation mode is output

Y[2] = OUTPUT(A1L9);



