--A1L11 is x_t~72
--operation mode is normal

A1L11 = x[1] & (x[3] # x[2]) # !x[1] & x[3] & x[2];


--A1L5 is a~1
--operation mode is normal

A1L5 = x[1] $ x[3];


--A1L4 is a~0
--operation mode is normal

A1L4 = x[3] $ x[2];


--x[1] is x[1]
--operation mode is input

x[1] = INPUT();


--x[3] is x[3]
--operation mode is input

x[3] = INPUT();


--x[2] is x[2]
--operation mode is input

x[2] = INPUT();


--x_t is x_t
--operation mode is output

x_t = OUTPUT(A1L11);


--a[0] is a[0]
--operation mode is output

a[0] = OUTPUT(A1L5);


--a[1] is a[1]
--operation mode is output

a[1] = OUTPUT(A1L4);


