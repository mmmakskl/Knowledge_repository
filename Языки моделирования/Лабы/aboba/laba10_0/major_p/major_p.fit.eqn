--A1L11 is x_t~72 at LC_X52_Y1_N4
--operation mode is normal

A1L11 = x[2] & (x[3] # x[1]) # !x[2] & x[3] & x[1];


--A1L5 is a~1 at LC_X52_Y1_N5
--operation mode is normal

A1L5 = x[3] $ x[1];


--A1L4 is a~0 at LC_X52_Y1_N2
--operation mode is normal

A1L4 = x[3] $ x[2];


--x[1] is x[1] at PIN_V4
--operation mode is input

x[1] = INPUT();


--x[3] is x[3] at PIN_T7
--operation mode is input

x[3] = INPUT();


--x[2] is x[2] at PIN_V3
--operation mode is input

x[2] = INPUT();


--x_t is x_t at PIN_AA2
--operation mode is output

x_t = OUTPUT(A1L11);


--a[0] is a[0] at PIN_W3
--operation mode is output

a[0] = OUTPUT(A1L5);


--a[1] is a[1] at PIN_AA3
--operation mode is output

a[1] = OUTPUT(A1L4);



