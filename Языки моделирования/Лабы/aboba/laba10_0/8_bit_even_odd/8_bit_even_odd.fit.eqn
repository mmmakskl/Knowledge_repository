--A1L3 is inst10~53 at LC_X9_Y1_N4
--operation mode is normal

A1L3 = X[5] $ X[1] $ X[6] $ X[7];


--A1L4 is inst10~54 at LC_X9_Y1_N2
--operation mode is normal

A1L4 = X[3] $ X[4] $ D $ X[2];


--A1L5 is inst10~55 at LC_X9_Y1_N5
--operation mode is normal

A1L5 = A1L3 $ X[0] $ (A1L4);


--X[7] is X[7] at PIN_AA16
--operation mode is input

X[7] = INPUT();


--X[5] is X[5] at PIN_W16
--operation mode is input

X[5] = INPUT();


--X[1] is X[1] at PIN_U17
--operation mode is input

X[1] = INPUT();


--X[6] is X[6] at PIN_V17
--operation mode is input

X[6] = INPUT();


--X[4] is X[4] at PIN_N13
--operation mode is input

X[4] = INPUT();


--D is D at PIN_N16
--operation mode is input

D = INPUT();


--X[2] is X[2] at PIN_AB16
--operation mode is input

X[2] = INPUT();


--X[3] is X[3] at PIN_Y15
--operation mode is input

X[3] = INPUT();


--X[0] is X[0] at PIN_V16
--operation mode is input

X[0] = INPUT();


--EVEN is EVEN at PIN_AA15
--operation mode is output

EVEN = OUTPUT(!A1L5);


--ODD is ODD at PIN_V15
--operation mode is output

ODD = OUTPUT(A1L5);



