--A1L3 is inst10~53
--operation mode is normal

A1L3 = X[7] $ X[5] $ X[1] $ X[6];


--A1L4 is inst10~54
--operation mode is normal

A1L4 = X[4] $ D $ X[2] $ X[3];


--A1L5 is inst10~55
--operation mode is normal

A1L5 = A1L3 $ A1L4 $ X[0];


--X[7] is X[7]
--operation mode is input

X[7] = INPUT();


--X[5] is X[5]
--operation mode is input

X[5] = INPUT();


--X[1] is X[1]
--operation mode is input

X[1] = INPUT();


--X[6] is X[6]
--operation mode is input

X[6] = INPUT();


--X[4] is X[4]
--operation mode is input

X[4] = INPUT();


--D is D
--operation mode is input

D = INPUT();


--X[2] is X[2]
--operation mode is input

X[2] = INPUT();


--X[3] is X[3]
--operation mode is input

X[3] = INPUT();


--X[0] is X[0]
--operation mode is input

X[0] = INPUT();


--EVEN is EVEN
--operation mode is output

EVEN = OUTPUT(!A1L5);


--ODD is ODD
--operation mode is output

ODD = OUTPUT(A1L5);


