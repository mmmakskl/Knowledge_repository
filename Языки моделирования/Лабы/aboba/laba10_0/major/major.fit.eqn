--A1L5 is inst11~66 at LC_X52_Y1_N4
--operation mode is normal

A1L5 = X3 & (X2 # X1) # !X3 & X2 & X1;


--inst8 is inst8 at LC_X52_Y1_N5
--operation mode is normal

inst8 = X2 $ X3;


--inst7 is inst7 at LC_X52_Y1_N2
--operation mode is normal

inst7 = X3 $ (X1);


--X1 is X1 at PIN_V4
--operation mode is input

X1 = INPUT();


--X2 is X2 at PIN_T7
--operation mode is input

X2 = INPUT();


--X3 is X3 at PIN_V3
--operation mode is input

X3 = INPUT();


--X is X at PIN_AA2
--operation mode is output

X = OUTPUT(A1L5);


--a1 is a1 at PIN_W3
--operation mode is output

a1 = OUTPUT(inst8);


--a0 is a0 at PIN_AA3
--operation mode is output

a0 = OUTPUT(inst7);



