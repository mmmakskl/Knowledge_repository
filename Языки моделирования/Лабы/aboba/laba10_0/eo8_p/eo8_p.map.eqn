--A1L3 is even_v~61
--operation mode is normal

A1L3 = x[0] $ x[2] $ x[6] $ x[1];


--A1L4 is even_v~62
--operation mode is normal

A1L4 = x[3] $ d $ x[5] $ x[4];


--A1L5 is even_v~63
--operation mode is normal

A1L5 = A1L3 $ A1L4 $ x[7];


--x[0] is x[0]
--operation mode is input

x[0] = INPUT();


--x[2] is x[2]
--operation mode is input

x[2] = INPUT();


--x[6] is x[6]
--operation mode is input

x[6] = INPUT();


--x[1] is x[1]
--operation mode is input

x[1] = INPUT();


--x[3] is x[3]
--operation mode is input

x[3] = INPUT();


--d is d
--operation mode is input

d = INPUT();


--x[5] is x[5]
--operation mode is input

x[5] = INPUT();


--x[4] is x[4]
--operation mode is input

x[4] = INPUT();


--x[7] is x[7]
--operation mode is input

x[7] = INPUT();


--even is even
--operation mode is output

even = OUTPUT(!A1L5);


--odd is odd
--operation mode is output

odd = OUTPUT(A1L5);


