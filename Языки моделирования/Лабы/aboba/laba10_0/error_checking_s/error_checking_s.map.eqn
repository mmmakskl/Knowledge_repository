--B2L1 is eo8_p:eo8_2|even_v~7
--operation mode is normal

B2L1 = x[1] $ x[0];


--x[1] is x[1]
--operation mode is input

x[1] = INPUT();


--x[0] is x[0]
--operation mode is input

x[0] = INPUT();


--x[2] is x[2]
--operation mode is input

x[2] = INPUT();


--x[3] is x[3]
--operation mode is input

x[3] = INPUT();


--x[4] is x[4]
--operation mode is input

x[4] = INPUT();


--x[5] is x[5]
--operation mode is input

x[5] = INPUT();


--x[6] is x[6]
--operation mode is input

x[6] = INPUT();


--x[7] is x[7]
--operation mode is input

x[7] = INPUT();


--IsError is IsError
--operation mode is output

IsError = OUTPUT(!B2L1);


--x_new[0] is x_new[0]
--operation mode is output

x_new[0] = OUTPUT(GND);


--x_new[1] is x_new[1]
--operation mode is output

x_new[1] = OUTPUT(VCC);


--x_new[2] is x_new[2]
--operation mode is output

x_new[2] = OUTPUT(x[2]);


--x_new[3] is x_new[3]
--operation mode is output

x_new[3] = OUTPUT(x[3]);


--x_new[4] is x_new[4]
--operation mode is output

x_new[4] = OUTPUT(x[4]);


--x_new[5] is x_new[5]
--operation mode is output

x_new[5] = OUTPUT(x[5]);


--x_new[6] is x_new[6]
--operation mode is output

x_new[6] = OUTPUT(x[6]);


--x_new[7] is x_new[7]
--operation mode is output

x_new[7] = OUTPUT(x[7]);


