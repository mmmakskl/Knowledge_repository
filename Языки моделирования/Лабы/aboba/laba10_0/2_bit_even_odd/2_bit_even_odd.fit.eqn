--A1L3 is inst4~13 at LC_X5_Y30_N2
--operation mode is normal

A1L3 = X[0] $ X[1] $ D;


--D is D at PIN_E18
--operation mode is input

D = INPUT();


--X[1] is X[1] at PIN_C18
--operation mode is input

X[1] = INPUT();


--X[0] is X[0] at PIN_D18
--operation mode is input

X[0] = INPUT();


--EVEN is EVEN at PIN_A18
--operation mode is output

EVEN = OUTPUT(A1L3);


--ODD is ODD at PIN_B18
--operation mode is output

ODD = OUTPUT(!A1L3);



