--A1L61 is k1~1 at LC_X52_Y30_N4
--operation mode is normal

A1L61 = d[0] $ (d[3] $ d[1]);


--A1L71 is k2~1 at LC_X52_Y30_N6
--operation mode is normal

A1L71 = d[0] $ d[2] $ d[3];


--A1L81 is k3~1 at LC_X52_Y30_N5
--operation mode is normal

A1L81 = d[1] $ d[2] $ d[3];


--A1L51 is d_o~10 at LC_X52_Y30_N2
--operation mode is normal

A1L51 = d[1] $ d[2] $ d[0];


--d[0] is d[0] at PIN_E1
--operation mode is input

d[0] = INPUT();


--d[3] is d[3] at PIN_D1
--operation mode is input

d[3] = INPUT();


--d[1] is d[1] at PIN_D2
--operation mode is input

d[1] = INPUT();


--d[2] is d[2] at PIN_B3
--operation mode is input

d[2] = INPUT();


--d_o[0] is d_o[0] at PIN_C2
--operation mode is output

d_o[0] = OUTPUT(A1L61);


--d_o[1] is d_o[1] at PIN_D3
--operation mode is output

d_o[1] = OUTPUT(A1L71);


--d_o[2] is d_o[2] at PIN_F5
--operation mode is output

d_o[2] = OUTPUT(d[0]);


--d_o[3] is d_o[3] at PIN_B4
--operation mode is output

d_o[3] = OUTPUT(A1L81);


--d_o[4] is d_o[4] at PIN_F3
--operation mode is output

d_o[4] = OUTPUT(d[1]);


--d_o[5] is d_o[5] at PIN_G7
--operation mode is output

d_o[5] = OUTPUT(d[2]);


--d_o[6] is d_o[6] at PIN_F4
--operation mode is output

d_o[6] = OUTPUT(d[3]);


--d_o[7] is d_o[7] at PIN_B2
--operation mode is output

d_o[7] = OUTPUT(A1L51);



