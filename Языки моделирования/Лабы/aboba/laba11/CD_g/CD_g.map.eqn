--B3_1 is XOR3:inst3|1
--operation mode is normal

B3_1 = D1 $ D0 $ D3;


--B2_1 is XOR3:inst2|1
--operation mode is normal

B2_1 = D0 $ D3 $ D2;


--B1_1 is XOR3:inst1|1
--operation mode is normal

B1_1 = D1 $ D3 $ D2;


--C1L1 is XOR8:inst7|39~3
--operation mode is normal

C1L1 = D1 $ D0 $ D2;


--D1 is D1
--operation mode is input

D1 = INPUT();


--D0 is D0
--operation mode is input

D0 = INPUT();


--D3 is D3
--operation mode is input

D3 = INPUT();


--D2 is D2
--operation mode is input

D2 = INPUT();


--K1 is K1
--operation mode is output

K1 = OUTPUT(B3_1);


--K2 is K2
--operation mode is output

K2 = OUTPUT(B2_1);


--K3 is K3
--operation mode is output

K3 = OUTPUT(B1_1);


--K is K
--operation mode is output

K = OUTPUT(C1L1);


--D0_o is D0_o
--operation mode is output

D0_o = OUTPUT(D0);


--D1_o is D1_o
--operation mode is output

D1_o = OUTPUT(D1);


--D2_o is D2_o
--operation mode is output

D2_o = OUTPUT(D2);


--D3_o is D3_o
--operation mode is output

D3_o = OUTPUT(D3);


