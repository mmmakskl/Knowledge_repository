--A1L52 is kp~59
--operation mode is normal

A1L52 = d[6] $ d[5] $ d[3] $ d[4];


--A1L62 is kp~60
--operation mode is normal

A1L62 = d[2] $ d[1];


--A1L42 is kp~6
--operation mode is normal

A1L42 = A1L52 $ A1L62 $ d[0] $ d[7];


--A1L13 is p2~73
--operation mode is normal

A1L13 = d[2] $ d[6] $ d[5] $ d[1];


--A1L82 is p1~90
--operation mode is normal

A1L82 = d[2] $ d[6] $ d[4] $ d[0];


--A1L51 is d_otv~758
--operation mode is normal

A1L51 = A1L82 & (!A1L52);


--A1L61 is d_otv~759
--operation mode is normal

A1L61 = d[2] $ (A1L42 & A1L13 & A1L51);


--A1L71 is d_otv~760
--operation mode is normal

A1L71 = A1L52 & (A1L62 $ d[0] $ !d[7]);


--A1L81 is d_otv~761
--operation mode is normal

A1L81 = d[4] $ (!A1L13 & A1L82 & A1L71);


--A1L91 is d_otv~762
--operation mode is normal

A1L91 = d[2] $ d[6] $ d[1];


--A1L02 is d_otv~763
--operation mode is normal

A1L02 = A1L71 & (A1L82 & d[5] # !A1L82 & (A1L91)) # !A1L71 & d[5];


--A1L03 is p2~1
--operation mode is normal

A1L03 = d[2] $ d[5] $ d[1];


--A1L92 is p1~91
--operation mode is normal

A1L92 = d[2] $ d[4] $ d[0];


--A1L12 is d_otv~764
--operation mode is normal

A1L12 = d[6] & (A1L03 # A1L92 # !A1L71) # !d[6] & A1L03 & A1L92 & A1L71;


--A1L32 is DBL_ERR~37
--operation mode is normal

A1L32 = !A1L42 & (A1L52 # A1L13 # A1L82);


--d[2] is d[2]
--operation mode is input

d[2] = INPUT();


--d[6] is d[6]
--operation mode is input

d[6] = INPUT();


--d[5] is d[5]
--operation mode is input

d[5] = INPUT();


--d[3] is d[3]
--operation mode is input

d[3] = INPUT();


--d[4] is d[4]
--operation mode is input

d[4] = INPUT();


--d[1] is d[1]
--operation mode is input

d[1] = INPUT();


--d[0] is d[0]
--operation mode is input

d[0] = INPUT();


--d[7] is d[7]
--operation mode is input

d[7] = INPUT();


--d_o[0] is d_o[0]
--operation mode is output

d_o[0] = OUTPUT(A1L61);


--d_o[1] is d_o[1]
--operation mode is output

d_o[1] = OUTPUT(A1L81);


--d_o[2] is d_o[2]
--operation mode is output

d_o[2] = OUTPUT(A1L02);


--d_o[3] is d_o[3]
--operation mode is output

d_o[3] = OUTPUT(A1L12);


--ONE_ERR is ONE_ERR
--operation mode is output

ONE_ERR = OUTPUT(A1L42);


--DBL_ERR is DBL_ERR
--operation mode is output

DBL_ERR = OUTPUT(A1L32);


