--A1L3 is inst14~131
--operation mode is normal

A1L3 = Y1 & (Y0 # !X1 # !X0) # !Y1 & !X1 & (Y0 # !X0);


--A1L2 is inst10~34
--operation mode is normal

A1L2 = Y1 & X1 & (Y0 $ !X0) # !Y1 & !X1 & (Y0 $ !X0);


--A1L4 is inst14~132
--operation mode is normal

A1L4 = A1L3 & (!A1L2 # !XGY0);


--A1L5 is inst15~131
--operation mode is normal

A1L5 = X1 & (X0 # !Y1 # !Y0) # !X1 & !Y1 & (X0 # !Y0);


--A1L6 is inst15~132
--operation mode is normal

A1L6 = A1L5 & (!XLY0 # !A1L2);


--inst9 is inst9
--operation mode is normal

inst9 = A1L2 & XEY0;


--Y1 is Y1
--operation mode is input

Y1 = INPUT();


--Y0 is Y0
--operation mode is input

Y0 = INPUT();


--X0 is X0
--operation mode is input

X0 = INPUT();


--X1 is X1
--operation mode is input

X1 = INPUT();


--XGY0 is XGY0
--operation mode is input

XGY0 = INPUT();


--XLY0 is XLY0
--operation mode is input

XLY0 = INPUT();


--XEY0 is XEY0
--operation mode is input

XEY0 = INPUT();


--XGY is XGY
--operation mode is output

XGY = OUTPUT(!A1L4);


--XLY is XLY
--operation mode is output

XLY = OUTPUT(!A1L6);


--XEY is XEY
--operation mode is output

XEY = OUTPUT(inst9);


