--data_in[1] is data_in[1] at PIN_B17
--operation mode is input

data_in[1] = INPUT();


--data_in[0] is data_in[0] at PIN_A17
--operation mode is input

data_in[0] = INPUT();


--data_in[3] is data_in[3] at PIN_C17
--operation mode is input

data_in[3] = INPUT();


--data_out is data_out at PIN_E18
--operation mode is output

data_out = OUTPUT(data_out_tmp);



