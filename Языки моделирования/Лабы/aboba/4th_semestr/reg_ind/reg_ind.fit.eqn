--data_out_tmp is data_out_tmp at LC_X6_Y26_N2
--operation mode is normal

data_out_tmp_lut_out = i[2] & (A1L2) # !i[2] & A1L4;
data_out_tmp = DFFEAS(data_out_tmp_lut_out, GLOBAL(read_clk), VCC, , , , , , );


--i[1] is i[1] at LC_X7_Y26_N1
--operation mode is normal

i[1]_lut_out = !i[1];
i[1] = DFFEAS(i[1]_lut_out, GLOBAL(read_clk), VCC, , i[0], , , , );


--i[0] is i[0] at LC_X6_Y26_N9
--operation mode is normal

i[0]_lut_out = !i[0];
i[0] = DFFEAS(i[0]_lut_out, GLOBAL(read_clk), VCC, , , , , , );


--data[4] is data[4] at LC_X5_Y28_N2
--operation mode is normal

data[4]_lut_out = GND;
data[4] = DFFEAS(data[4]_lut_out, GLOBAL(write_clk), VCC, , , data_in[4], , , VCC);


--A1L1 is Mux~29 at LC_X6_Y26_N6
--operation mode is normal

data[5]_qfbk = data[5];
A1L1 = i[1] & i[0] # !i[1] & (i[0] & data[5]_qfbk # !i[0] & (data[4]));

--data[5] is data[5] at LC_X6_Y26_N6
--operation mode is normal

data[5] = DFFEAS(A1L1, GLOBAL(write_clk), VCC, , , data_in[5], , , VCC);


--data[7] is data[7] at LC_X6_Y26_N3
--operation mode is normal

data[7]_lut_out = data_in[7];
data[7] = DFFEAS(data[7]_lut_out, GLOBAL(write_clk), VCC, , , , , , );


--A1L2 is Mux~30 at LC_X6_Y26_N7
--operation mode is normal

data[6]_qfbk = data[6];
A1L2 = A1L1 & (data[7] # !i[1]) # !A1L1 & (data[6]_qfbk & i[1]);

--data[6] is data[6] at LC_X6_Y26_N7
--operation mode is normal

data[6] = DFFEAS(A1L2, GLOBAL(write_clk), VCC, , , data_in[6], , , VCC);


--data[0] is data[0] at LC_X6_Y26_N0
--operation mode is normal

data[0]_lut_out = GND;
data[0] = DFFEAS(data[0]_lut_out, GLOBAL(write_clk), VCC, , , data_in[0], , , VCC);


--A1L3 is Mux~31 at LC_X6_Y26_N8
--operation mode is normal

data[1]_qfbk = data[1];
A1L3 = i[1] & i[0] # !i[1] & (i[0] & data[1]_qfbk # !i[0] & (data[0]));

--data[1] is data[1] at LC_X6_Y26_N8
--operation mode is normal

data[1] = DFFEAS(A1L3, GLOBAL(write_clk), VCC, , , data_in[1], , , VCC);


--data[3] is data[3] at LC_X6_Y26_N4
--operation mode is normal

data[3]_lut_out = data_in[3];
data[3] = DFFEAS(data[3]_lut_out, GLOBAL(write_clk), VCC, , , , , , );


--A1L4 is Mux~32 at LC_X6_Y26_N1
--operation mode is normal

data[2]_qfbk = data[2];
A1L4 = i[1] & (A1L3 & data[3] # !A1L3 & (data[2]_qfbk)) # !i[1] & (A1L3);

--data[2] is data[2] at LC_X6_Y26_N1
--operation mode is normal

data[2] = DFFEAS(A1L4, GLOBAL(write_clk), VCC, , , data_in[2], , , VCC);


--i[2] is i[2] at LC_X5_Y26_N2
--operation mode is normal

i[2]_lut_out = !i[2];
i[2] = DFFEAS(i[2]_lut_out, GLOBAL(read_clk), VCC, , A1L5, , , , );


--A1L5 is add~186 at LC_X6_Y26_N5
--operation mode is normal

A1L5 = i[0] & (i[1]);


--read_clk is read_clk at PIN_L3
--operation mode is input

read_clk = INPUT();


--data_in[6] is data_in[6] at PIN_A18
--operation mode is input

data_in[6] = INPUT();


--write_clk is write_clk at PIN_L2
--operation mode is input

write_clk = INPUT();


--data_in[5] is data_in[5] at PIN_E17
--operation mode is input

data_in[5] = INPUT();


--data_in[4] is data_in[4] at PIN_D17
--operation mode is input

data_in[4] = INPUT();


--data_in[7] is data_in[7] at PIN_F17
--operation mode is input

