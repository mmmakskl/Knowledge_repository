[Leonardo]
my_project_lib = $HDS_PROJECT_DIR/my_project_lib/ls
[ModelSim]
my_project_lib = $HDS_PROJECT_DIR/my_project_lib/work
[QuestaSim]
my_project_lib = $HDS_PROJECT_DIR\my_project_lib\work
[hdl]
my_project_lib = $HDS_PROJECT_DIR/my_project_lib/hdl
[hds]
