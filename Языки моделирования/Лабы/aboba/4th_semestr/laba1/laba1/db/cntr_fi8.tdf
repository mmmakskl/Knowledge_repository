FUNCTION stratix_lcell (aclr, aload, cin, clk, dataa, datab, datac, datad, ena, inverta, regcascin, sclr, sload)
WITH ( 	cin_used,	lut_mask,	operation_mode,	output_mode,	register_cascade_mode,	sum_lutc_input,	synch_mode) 
RETURNS ( combout, cout, regout);

--synthesis_resources = lut 1 
SUBDESIGN cntr_fi8
( 
	clock	:	input;
	cout	:	output;
	q[0..0]	:	output;
	sset	:	input;
) 
VARIABLE 
	counter_cella0 : stratix_lcell
		WITH (
			cin_used = "false",
			lut_mask = "11AA",
			operation_mode = "arithmetic",
			synch_mode = "on"
		);
	a_val[0..0]	: WIRE;
	aclr	: NODE;
	aclr_actual	: WIRE;
	aset_node	: WIRE;
	clk_en	: NODE;
	data[0..0]	: NODE;
	s_val[0..0]	: WIRE;
	safe_q[0..0]	: WIRE;
	sclr	: NODE;
	sload	: NODE;
	sset_node	: WIRE;
	time_to_clear	: WIRE;
	updownDir	: WIRE;

BEGIN 
	counter_cella[0..0].aclr = aclr_actual;
	counter_cella[0..0].aload = B"0";
	counter_cella[0..0].clk = clock;
	counter_cella[0..0].dataa = safe_q[];
	counter_cella[0..0].datab = sset_node;
	counter_cella[0..0].datac = data[];
	counter_cella[0..0].ena = clk_en;
	counter_cella[0..0].sclr = sclr;
	counter_cella[0..0].sload = (sload & (! sset_node));
	a_val[] = B"1";
	aclr = GND;
	aclr_actual = aclr;
	aset_node = B"0";
	clk_en = VCC;
	cout = counter_cella[0].cout;
	data[] = GND;
	q[] = safe_q[];
	s_val[] = B"0";
	safe_q[] = counter_cella[0..0].regout;
	sclr = GND;
	sload = GND;
	sset_node = sset;
	time_to_clear = B"0";
	updownDir = B"1";
END;
--VALID FILE
