--inst is inst at LC_X52_Y1_N2
--operation mode is normal

inst = R # !S & inst;


--R is R at PIN_V4
--operation mode is input

R = INPUT();


--S is S at PIN_W4
--operation mode is input

S = INPUT();


--Q is Q at PIN_W3
--operation mode is output

Q = OUTPUT(!inst);



