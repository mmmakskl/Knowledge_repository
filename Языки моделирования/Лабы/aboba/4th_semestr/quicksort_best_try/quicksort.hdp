[ModelSim]
quicksort_lib = $HDS_PROJECT_DIR/quicksort_lib/work
[QuestaSim]
quicksort_lib = $HDS_PROJECT_DIR/quicksort_lib/work
[hdl]
quicksort_lib = $HDS_PROJECT_DIR/quicksort_lib/hdl
[hds]
quicksort_lib = $HDS_PROJECT_DIR/quicksort_lib/hds
[hds_settings]
default_library = quicksort_lib
design_root = .()
version = 1
[library_type]
quicksort_lib = regular
[shared]
others = $HDS_TEAM_HOME/shared.hdp
