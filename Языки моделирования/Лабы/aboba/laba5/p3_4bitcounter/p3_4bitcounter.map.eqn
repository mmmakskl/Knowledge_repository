--inst7 is inst7
--operation mode is normal

inst7_lut_out = !inst7;
inst7 = DFFEAS(inst7_lut_out, !inst5, r, , jk, , , , );


--inst is inst
--operation mode is normal

inst_lut_out = !inst;
inst = DFFEAS(inst_lut_out, c, r, , jk, , , , );


--inst4 is inst4
--operation mode is normal

inst4_lut_out = !inst4;
inst4 = DFFEAS(inst4_lut_out, !inst, r, , jk, , , , );


--inst5 is inst5
--operation mode is normal

inst5_lut_out = !inst5;
inst5 = DFFEAS(inst5_lut_out, !inst4, r, , jk, , , , );


--r is r
--operation mode is input

r = INPUT();


--jk is jk
--operation mode is input

jk = INPUT();


--c is c
--operation mode is input

c = INPUT();


--q3 is q3
--operation mode is output

q3 = OUTPUT(inst7);


--q0 is q0
--operation mode is output

q0 = OUTPUT(inst);


--q1 is q1
--operation mode is output

q1 = OUTPUT(inst4);


--q2 is q2
--operation mode is output

q2 = OUTPUT(inst5);


