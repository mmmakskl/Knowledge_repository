--inst7 is inst7 at LC_X8_Y30_N6
--operation mode is normal

inst7_lut_out = !inst7;
inst7 = DFFEAS(inst7_lut_out, !inst5, GLOBAL(r), , jk, , , , );


--inst is inst at LC_X9_Y30_N4
--operation mode is normal

inst_lut_out = !inst;
inst = DFFEAS(inst_lut_out, c, GLOBAL(r), , jk, , , , );


--inst4 is inst4 at LC_X9_Y30_N2
--operation mode is normal

inst4_lut_out = !inst4;
inst4 = DFFEAS(inst4_lut_out, !inst, GLOBAL(r), , jk, , , , );


--inst5 is inst5 at LC_X8_Y30_N5
--operation mode is normal

inst5_lut_out = !inst5;
inst5 = DFFEAS(inst5_lut_out, !inst4, GLOBAL(r), , jk, , , , );


--r is r at PIN_L2
--operation mode is input

r = INPUT();


--jk is jk at PIN_D16
--operation mode is input

jk = INPUT();


--c is c at PIN_B16
--operation mode is input

c = INPUT();


--q3 is q3 at PIN_F17
--operation mode is output

q3 = OUTPUT(inst7);


--q0 is q0 at PIN_A16
--operation mode is output

q0 = OUTPUT(inst);


--q1 is q1 at PIN_E16
--operation mode is output

q1 = OUTPUT(inst4);


--q2 is q2 at PIN_B17
--operation mode is output

q2 = OUTPUT(inst5);



