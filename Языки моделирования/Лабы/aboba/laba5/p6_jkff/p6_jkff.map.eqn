--A1L5 is process0~30
--operation mode is normal

A1L5 = s1 # k & (!j);


--A1L3 is process0~1
--operation mode is normal

A1L3 = j & (!k);


--A1L4 is process0~7
--operation mode is normal

A1L4 = j # k;


--s is s
--operation mode is normal

s = A1L4 & (A1L3 # !A1L5) # !A1L4 & (s);


--A1L6 is process0~31
--operation mode is normal

A1L6 = j $ k;


--s1 is s1
--operation mode is normal

s1 = A1L6 & s # !A1L6 & (s1);


--k is k
--operation mode is input

k = INPUT();


--j is j
--operation mode is input

j = INPUT();


--q is q
--operation mode is output

q = OUTPUT(s);


