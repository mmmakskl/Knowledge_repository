--A1L5 is process0~30 at LC_X52_Y1_N7
--operation mode is normal

A1L5 = s1 # !j & k;


--A1L3 is process0~1 at LC_X52_Y1_N9
--operation mode is normal

A1L3 = j & !k;


--A1L4 is process0~7 at LC_X52_Y1_N2
--operation mode is normal

A1L4 = j # k;


--s is s at LC_X52_Y1_N8
--operation mode is normal

s = A1L4 & (A1L3 # !A1L5) # !A1L4 & (s);


--A1L6 is process0~31 at LC_X52_Y1_N5
--operation mode is normal

A1L6 = j $ k;


--s1 is s1 at LC_X52_Y1_N6
--operation mode is normal

s1 = A1L6 & (s) # !A1L6 & s1;


--k is k at PIN_V4
--operation mode is input

k = INPUT();


--j is j at PIN_W4
--operation mode is input

j = INPUT();


--q is q at PIN_W3
--operation mode is output

q = OUTPUT(s);



