--B1_16 is 7493:inst|16
--operation mode is normal

B1_16_lut_out = !B1_16;
B1_16 = DFFEAS(B1_16_lut_out, !c, !B1_13, , , , , , );


--B1_15 is 7493:inst|15
--operation mode is normal

B1_15_lut_out = !B1_15;
B1_15 = DFFEAS(B1_15_lut_out, !B1_16, !B1_13, , , , , , );


--B1_14 is 7493:inst|14
--operation mode is normal

B1_14_lut_out = !B1_14;
B1_14 = DFFEAS(B1_14_lut_out, !B1_16, !B1_13, , B1_15, , , , );


--B1_13 is 7493:inst|13
--operation mode is normal

B1_13_lut_out = VCC;
B1_13 = DFFEAS(B1_13_lut_out, !B1_16, !B1_13, , B1_39, , , , );


--B1_39 is 7493:inst|39
--operation mode is normal

B1_39 = B1_15 & B1_14;


--c is c
--operation mode is input

c = INPUT();


--q0 is q0
--operation mode is output

q0 = OUTPUT(B1_16);


--q1 is q1
--operation mode is output

q1 = OUTPUT(B1_15);


--q2 is q2
--operation mode is output

q2 = OUTPUT(B1_14);


--q3 is q3
--operation mode is output

q3 = OUTPUT(B1_13);


