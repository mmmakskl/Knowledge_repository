--A1L23 is process0~194 at LC_X1_Y20_N7
--operation mode is normal

A1L23 = !r[5] & !r[6] & ei & !r[7];


--A1L33 is process0~195 at LC_X1_Y20_N8
--operation mode is normal

A1L33 = !r[4] & (A1L23 & !r[3]);


--A1L13 is process0~9 at LC_X1_Y21_N3
--operation mode is normal

A1L13 = r[1] # r[2] # r[0] # !A1L33;


--A1L62 is comb~318 at LC_X1_Y21_N2
--operation mode is normal

A1L62 = !r[1] & !r[2] & r[0] & A1L33;


--A1L72 is comb~319 at LC_X1_Y21_N4
--operation mode is normal

A1L72 = r[1] # r[2] # !A1L33;


--a[0]$latch is a[0]$latch at LC_X1_Y21_N9
--operation mode is normal

a[0]$latch = !A1L72 & (A1L62 # a[0]$latch & !GLOBAL(A1L13));


--A1L43 is process0~196 at LC_X1_Y21_N5
--operation mode is normal

A1L43 = r[1] & !r[2] & (A1L33);


--A1L52 is comb~14 at LC_X1_Y21_N1
--operation mode is normal

A1L52 = r[2] # !r[1] & r[0] # !A1L33;


--a[1]$latch is a[1]$latch at LC_X1_Y21_N6
--operation mode is normal

a[1]$latch = !A1L52 & (A1L43 # a[1]$latch);


--A1L82 is comb~320 at LC_X1_Y20_N1
--operation mode is normal

A1L82 = !r[4] & r[2] & A1L23 & !r[3];


--A1L92 is comb~321 at LC_X1_Y21_N7
--operation mode is normal

A1L92 = !r[2] & (r[1] # r[0]) # !A1L33;


--a[2]$latch is a[2]$latch at LC_X1_Y21_N8
--operation mode is normal

a[2]$latch = !A1L92 & (A1L82 # a[2]$latch & !GLOBAL(A1L13));


--A1L91 is comb~3 at LC_X1_Y20_N5
--operation mode is normal

A1L91 = !r[4] & A1L13 & A1L23 & r[3];


--A1L42 is comb~12 at LC_X1_Y20_N9
--operation mode is normal

A1L42 = A1L13 & (r[4] # !r[3] # !A1L23);


--a[3]$latch is a[3]$latch at LC_X1_Y20_N0
--operation mode is normal

a[3]$latch = !A1L42 & (A1L91 # a[3]$latch & !GLOBAL(A1L13));


--A1L81 is comb~2 at LC_X1_Y20_N4
--operation mode is normal

A1L81 = r[4] & (A1L23 & A1L13);


--A1L32 is comb~11 at LC_X1_Y20_N2
--operation mode is normal

A1L32 = A1L13 & (!A1L23 # !r[4]);


--a[4]$latch is a[4]$latch at LC_X1_Y20_N3
--operation mode is normal

a[4]$latch = !A1L32 & (A1L81 # a[4]$latch & !GLOBAL(A1L13));


--A1L53 is process0~197 at LC_X1_Y20_N6
--operation mode is normal

A1L53 = r[5] & !r[6] & ei & !r[7];


--A1L22 is comb~10 at LC_X1_Y18_N6
--operation mode is normal

A1L22 = !A1L53 & (A1L13);


--a[5]$latch is a[5]$latch at LC_X1_Y18_N2
--operation mode is normal

a[5]$latch = !A1L22 & (a[5]$latch # A1L53);


--A1L63 is process0~198 at LC_X1_Y19_N8
--operation mode is normal

A1L63 = ei & r[6] & !r[7];


--A1L12 is comb~9 at LC_X1_Y19_N4
--operation mode is normal

A1L12 = A1L13 & (r[7] # !r[6] # !ei);


--a[6]$latch is a[6]$latch at LC_X1_Y19_N9
--operation mode is normal

a[6]$latch = !A1L12 & (A1L63 # a[6]$latch);


--A1L73 is process0~199 at LC_X1_Y19_N2
--operation mode is normal

A1L73 = ei & (r[7]);


--A1L02 is comb~8 at LC_X1_Y19_N5
--operation mode is normal

A1L02 = A1L13 & (!ei # !r[7]);


--a[7]$latch is a[7]$latch at LC_X1_Y19_N6
--operation mode is normal

a[7]$latch = !A1L02 & (A1L73 # a[7]$latch);


--r[0] is r[0] at PIN_H19
--operation mode is input

r[0] = INPUT();


--r[1] is r[1] at PIN_H21
--operation mode is input

r[1] = INPUT();


--r[2] is r[2] at PIN_H22
--operation mode is input

r[2] = INPUT();


--ei is ei at PIN_L21
--operation mode is input

ei = INPUT();


