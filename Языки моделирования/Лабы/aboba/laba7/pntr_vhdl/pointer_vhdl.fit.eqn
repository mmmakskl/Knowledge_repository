--operation mode is input

r[5] = INPUT();


--r[6] is r[6] at PIN_L20
--operation mode is input

r[6] = INPUT();


--r[7] is r[7] at PIN_L22
--operation mode is input

r[7] = INPUT();


--r[3] is r[3] at PIN_G21
--operation mode is input

r[3] = INPUT();


--r[4] is r[4] at PIN_G22
--operation mode is input

r[4] = INPUT();


--a[0] is a[0] at PIN_J20
--operation mode is output

a[0] = OUTPUT(a[0]$latch);


--a[1] is a[1] at PIN_F21
--operation mode is output

a[1] = OUTPUT(a[1]$latch);


--a[2] is a[2] at PIN_L17
--operation mode is output

a[2] = OUTPUT(a[2]$latch);


--a[3] is a[3] at PIN_K20
--operation mode is output

