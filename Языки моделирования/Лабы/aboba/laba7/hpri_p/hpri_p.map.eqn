--A1L01 is comb~280
--operation mode is normal

A1L01 = !r[6] & !r[4] & !r[5] & !r[7];


--A1L81 is eo~85
--operation mode is normal

A1L81 = r[3] # r[2] # r[0] # r[1];


--A1L71 is eo~7
--operation mode is normal

A1L71 = ei & A1L01 & (!A1L81);


--A1L02 is g~0
--operation mode is normal

A1L02 = ei & (A1L81 # !A1L01);


--A1L12 is process0~197
--operation mode is normal

A1L12 = !r[4] & (r[3] # r[1] & !r[2]);


--A1L22 is process0~198
--operation mode is normal

A1L22 = r[7] # !r[6] & (r[5] # A1L12);


--A1L11 is comb~281
--operation mode is normal

A1L11 = ei & (A1L22 # A1L01 & !A1L81);


--a[0]$latch is a[0]$latch
--operation mode is normal

a[0]$latch = A1L11 & (a[0]$latch & A1L71 # !A1L9);


--A1L32 is process0~199
--operation mode is normal

A1L32 = !r[4] & !r[5] & (r[3] # r[2]);


--A1L42 is process0~200
--operation mode is normal

A1L42 = r[6] # r[7] # A1L32;


--A1L21 is comb~282
--operation mode is normal

A1L21 = ei & (A1L42 # A1L01 & !A1L81);


--a[1]$latch is a[1]$latch
--operation mode is normal

a[1]$latch = A1L21 & (a[1]$latch & A1L71 # !A1L8);


--A1L31 is comb~283
--operation mode is normal

A1L31 = A1L01 # !ei;


--A1L41 is comb~284
--operation mode is normal

A1L41 = ei & (!A1L81 # !A1L01);


--a[2]$latch is a[2]$latch
--operation mode is normal

a[2]$latch = A1L41 & (a[2]$latch & A1L71 # !A1L31);


--A1L9 is comb~1
--operation mode is normal

A1L9 = A1L01 & !A1L81 # !A1L22 # !ei;


--A1L8 is comb~0
--operation mode is normal

A1L8 = A1L01 & !A1L81 # !A1L42 # !ei;


--ei is ei
--operation mode is input

ei = INPUT();


--r[6] is r[6]
--operation mode is input

r[6] = INPUT();


--r[4] is r[4]
--operation mode is input

r[4] = INPUT();


--r[5] is r[5]
--operation mode is input

r[5] = INPUT();


--r[7] is r[7]
--operation mode is input

r[7] = INPUT();


--r[3] is r[3]
--operation mode is input

r[3] = INPUT();


--r[2] is r[2]
--operation mode is input

r[2] = INPUT();


--r[0] is r[0]
--operation mode is input

r[0] = INPUT();


--r[1] is r[1]
--operation mode is input

r[1] = INPUT();


--eo is eo
--operation mode is output

eo = OUTPUT(A1L71);


--g is g
--operation mode is output

g = OUTPUT(A1L02);


--a[0] is a[0]
--operation mode is output

a[0] = OUTPUT(a[0]$latch);


--a[1] is a[1]
--operation mode is output

a[1] = OUTPUT(a[1]$latch);


--a[2] is a[2]
--operation mode is output

a[2] = OUTPUT(a[2]$latch);


