--C1L5 is 74138:inst2|15~162
--operation mode is normal

C1L5 = r5 & (!r6 & !r7);


--C1L6 is 74138:inst2|15~163
--operation mode is normal

C1L6 = r6 & (!r7);


--C1L7 is 74138:inst2|15~164
--operation mode is normal

C1L7 = r4 & !r5 & !r7 & !r6;


--C1L8 is 74138:inst2|15~165
--operation mode is normal

C1L8 = C1L1 & !r4 & !r7 & !r6;


--C1L1 is 74138:inst2|15~114
--operation mode is normal

C1L1 = !r2 & !r1 & !r3 & !r5;


--C1L9 is 74138:inst2|15~166
--operation mode is normal

C1L9 = C1L2 & !r7 & !r6 & !r5;


--C1L2 is 74138:inst2|15~129
--operation mode is normal

C1L2 = !r4 & !r2 & r1 & !r3;


--C1L01 is 74138:inst2|15~167
--operation mode is normal

C1L01 = C1L3 & !r4 & !r7 & !r6;


--C1L3 is 74138:inst2|15~144
--operation mode is normal

C1L3 = r2 & !r3 & !r5;


--C1L4 is 74138:inst2|15~156
--operation mode is normal

C1L4 = !r4 & r3;


--C1L11 is 74138:inst2|15~168
--operation mode is normal

C1L11 = C1L4 & !r7 & !r6 & !r5;


--r0 is r0
--operation mode is input

r0 = INPUT();


--r6 is r6
--operation mode is input

r6 = INPUT();


--r7 is r7
--operation mode is input

r7 = INPUT();


--r4 is r4
--operation mode is input

r4 = INPUT();


--r5 is r5
--operation mode is input

r5 = INPUT();


--r3 is r3
--operation mode is input

r3 = INPUT();


--r1 is r1
--operation mode is input

r1 = INPUT();


--r2 is r2
--operation mode is input

r2 = INPUT();


--q0 is q0
--operation mode is output

q0 = OUTPUT(!C1L8);


--q1 is q1
--operation mode is output

q1 = OUTPUT(!C1L9);


--q2 is q2
--operation mode is output

q2 = OUTPUT(!C1L01);


--q3 is q3
--operation mode is output

q3 = OUTPUT(!C1L11);


--q4 is q4
--operation mode is output

q4 = OUTPUT(!C1L7);


--q5 is q5
--operation mode is output

q5 = OUTPUT(!C1L5);


--q6 is q6
--operation mode is output

q6 = OUTPUT(!C1L6);


--q7 is q7
--operation mode is output

q7 = OUTPUT(!r7);


