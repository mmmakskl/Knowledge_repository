--A1L2 is inst~39 at LC_X1_Y1_N2
--operation mode is normal

A1L2 = x7 # x0 # x4 # x2;


--A1L3 is inst~40 at LC_X1_Y1_N5
--operation mode is normal

A1L3 = x3 # x5;


--inst is inst at LC_X1_Y1_N4
--operation mode is normal

inst = A1L2 # A1L3 # x1 # x6;


--x2 is x2 at PIN_Y21
--operation mode is input

x2 = INPUT();


--x7 is x7 at PIN_W21
--operation mode is input

x7 = INPUT();


--x0 is x0 at PIN_AA20
--operation mode is input

x0 = INPUT();


--x4 is x4 at PIN_W20
--operation mode is input

x4 = INPUT();


--x3 is x3 at PIN_W19
--operation mode is input

x3 = INPUT();


--x5 is x5 at PIN_U19
--operation mode is input

x5 = INPUT();


--x6 is x6 at PIN_U20
--operation mode is input

x6 = INPUT();


--x1 is x1 at PIN_Y20
--operation mode is input

x1 = INPUT();


--q is q at PIN_AA21
--operation mode is output

q = OUTPUT(inst);



