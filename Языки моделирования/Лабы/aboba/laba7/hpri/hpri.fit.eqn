--A1L9 is inst14~38 at LC_X52_Y1_N3
--operation mode is normal

A1L9 = !r5 & !r4 & (r3 # r2);


--A1L01 is inst14~39 at LC_X52_Y1_N4
--operation mode is normal

A1L01 = EI & (r6 # r7 # A1L9);


--A1L7 is inst13~38 at LC_X52_Y1_N1
--operation mode is normal

A1L7 = !r5 & !r7 & !r4 & !r6;


--A1L51 is inst17~24 at LC_X52_Y1_N9
--operation mode is normal

A1L51 = !r1 & !r0 & !r3 & !r2;


--inst17 is inst17 at LC_X52_Y1_N2
--operation mode is normal

inst17 = EI & A1L7 & A1L51;


--inst19 is inst19 at LC_X52_Y1_N7
--operation mode is normal

inst19 = EI & (!A1L51 # !A1L7);


--A1L8 is inst13~39 at LC_X52_Y1_N5
--operation mode is normal

A1L8 = !A1L7 & EI;


--A1L11 is inst15~85 at LC_X52_Y1_N6
--operation mode is normal

A1L11 = EI & (r7 # r5 & !r6);


--A1L21 is inst15~86 at LC_X52_Y1_N8
--operation mode is normal

A1L21 = !r4 & (r3 # r1 & !r2);


--A1L31 is inst15~87 at LC_X52_Y1_N0
--operation mode is normal

A1L31 = A1L11 # !r6 & EI & A1L21;


--EI is EI at PIN_V4
--operation mode is input

EI = INPUT();


--r3 is r3 at PIN_W4
--operation mode is input

r3 = INPUT();


--r2 is r2 at PIN_W2
--operation mode is input

r2 = INPUT();


--r4 is r4 at PIN_Y3
--operation mode is input

r4 = INPUT();


--r5 is r5 at PIN_T5
--operation mode is input

r5 = INPUT();


--r7 is r7 at PIN_T7
--operation mode is input

r7 = INPUT();


--r6 is r6 at PIN_AA4
--operation mode is input

r6 = INPUT();


--r1 is r1 at PIN_W3
--operation mode is input

r1 = INPUT();


--r0 is r0 at PIN_AA2
--operation mode is input

r0 = INPUT();


--a1 is a1 at PIN_P7
--operation mode is output

a1 = OUTPUT(A1L01);


--EO is EO at PIN_W1
--operation mode is output

EO = OUTPUT(inst17);


--G is G at PIN_U5
--operation mode is output

G = OUTPUT(inst19);


--a2 is a2 at PIN_AA3
--operation mode is output

a2 = OUTPUT(A1L8);


--a0 is a0 at PIN_V3
--operation mode is output

a0 = OUTPUT(A1L31);



