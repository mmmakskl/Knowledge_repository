--B1L1 is 74138:inst|1~13
--operation mode is normal

B1L1 = G2AN # G2BN # !G1;


--B1_15 is 74138:inst|15
--operation mode is normal

B1_15 = !A & !B1L1 & !B & !C;


--B1_16 is 74138:inst|16
--operation mode is normal

B1_16 = A & !B1L1 & !B & !C;


--B1_17 is 74138:inst|17
--operation mode is normal

B1_17 = B & !A & !B1L1 & !C;


--B1_18 is 74138:inst|18
--operation mode is normal

B1_18 = A & B & !B1L1 & !C;


--B1_19 is 74138:inst|19
--operation mode is normal

B1_19 = C & !A & !B1L1 & !B;


--B1_20 is 74138:inst|20
--operation mode is normal

B1_20 = A & C & !B1L1 & !B;


--B1_21 is 74138:inst|21
--operation mode is normal

B1_21 = B & C & !A & !B1L1;


--B1_22 is 74138:inst|22
--operation mode is normal

B1_22 = A & B & C & !B1L1;


--A is A
--operation mode is input

A = INPUT();


--G2AN is G2AN
--operation mode is input

G2AN = INPUT();


--G2BN is G2BN
--operation mode is input

G2BN = INPUT();


--G1 is G1
--operation mode is input

G1 = INPUT();


--B is B
--operation mode is input

B = INPUT();


--C is C
--operation mode is input

C = INPUT();


--Y0 is Y0
--operation mode is output

Y0 = OUTPUT(!B1_15);


--Y1 is Y1
--operation mode is output

Y1 = OUTPUT(!B1_16);


--Y2 is Y2
--operation mode is output

Y2 = OUTPUT(!B1_17);


--Y3 is Y3
--operation mode is output

Y3 = OUTPUT(!B1_18);


--Y4 is Y4
--operation mode is output

Y4 = OUTPUT(!B1_19);


--Y5 is Y5
--operation mode is output

Y5 = OUTPUT(!B1_20);


--Y6 is Y6
--operation mode is output

Y6 = OUTPUT(!B1_21);


--Y7 is Y7
--operation mode is output

Y7 = OUTPUT(!B1_22);


