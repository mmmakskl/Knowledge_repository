--A1L4Q is d1~reg0
--operation mode is normal

A1L4Q_lut_out = d;
A1L4Q = DFFEAS(A1L4Q_lut_out, c, VCC, , r, , , , );


--d31 is d31
--operation mode is normal

d31_lut_out = d21;
d31 = DFFEAS(d31_lut_out, c, VCC, , r, , , , );


--d21 is d21
--operation mode is normal

d21_lut_out = A1L4Q;
d21 = DFFEAS(d21_lut_out, !c, VCC, , r, , , , );


--A1L01Q is q2~reg0
--operation mode is normal

A1L01Q_lut_out = d31;
A1L01Q = DFFEAS(A1L01Q_lut_out, !c, VCC, , r, , , , );


--d is d
--operation mode is input

d = INPUT();


--c is c
--operation mode is input

c = INPUT();


--r is r
--operation mode is input

r = INPUT();


--d1 is d1
--operation mode is output

d1 = OUTPUT(A1L4Q);


--d2 is d2
--operation mode is output

d2 = OUTPUT(d31);


--q1 is q1
--operation mode is output

q1 = OUTPUT(d21);


--q2 is q2
--operation mode is output

q2 = OUTPUT(A1L01Q);


