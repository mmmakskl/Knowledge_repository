--B1L4 is 7483:inst|27~1 at LC_X18_Y30_N9
--operation mode is normal

B1L4 = Y1 $ X1;


--B1L5 is 7483:inst|43~39 at LC_X18_Y30_N6
--operation mode is normal

B1L5 = Y2 $ X2 $ (Y1 & X1);


--B1L1 is 7483:inst|1~199 at LC_X18_Y30_N2
--operation mode is normal

B1L1 = Y2 & !X2 & (!X1 # !Y1) # !Y2 & (!X2 # !X1 # !Y1);


--B1_44 is 7483:inst|44 at LC_X18_Y30_N3
--operation mode is normal

B1_44 = X3 $ Y3 $ B1L1;


--B1L2 is 7483:inst|1~200 at LC_X18_Y30_N7
--operation mode is normal

B1L2 = X3 & !Y3 & B1L1 # !X3 & (B1L1 # !Y3);


--B1_45 is 7483:inst|45 at LC_X18_Y30_N4
--operation mode is normal

B1_45 = Y4 $ X4 $ B1L2;


--B1L3 is 7483:inst|2~77 at LC_X18_Y30_N8
--operation mode is normal

B1L3 = Y4 & !X4 & (B1L2) # !Y4 & (B1L2 # !X4);


--B2_42 is 7483:inst1|42 at LC_X52_Y5_N7
--operation mode is normal

B2_42 = Y5 $ B1L3 $ !X5;


--A1L32 is Y5~36 at LC_X52_Y5_N9
--operation mode is normal

A1L32 = !Y5 & !X5;


--B2L5 is 7483:inst1|18~44 at LC_X52_Y5_N1
--operation mode is normal

B2L5 = B1L3 & (!X5 # !Y5);


--B2_43 is 7483:inst1|43 at LC_X52_Y5_N0
--operation mode is normal

B2_43 = X6 $ Y6 $ (A1L32 # B2L5);


--B2L01 is 7483:inst1|51~59 at LC_X52_Y5_N8
--operation mode is normal

B2L01 = X6 & !Y6 & (A1L32 # B2L5) # !X6 & (A1L32 # B2L5 # !Y6);


--B2_44 is 7483:inst1|44 at LC_X52_Y5_N3
--operation mode is normal

B2_44 = X7 $ (Y7 $ B2L01);


--B2L1 is 7483:inst1|1~53 at LC_X52_Y5_N4
--operation mode is normal

B2L1 = X6 & (Y6 # Y7 & X7) # !X6 & (Y7 & X7);


--B2L2 is 7483:inst1|1~54 at LC_X52_Y5_N5
--operation mode is normal

B2L2 = !B2L1 & (X5 & !Y5 & B1L3 # !X5 & (B1L3 # !Y5));


--B2L3 is 7483:inst1|1~55 at LC_X52_Y5_N6
--operation mode is normal

B2L3 = Y7 & !X6 & !Y6 & !X7 # !Y7 & (!X6 & !Y6 # !X7);


--B2_45 is 7483:inst1|45 at LC_X52_Y5_N2
--operation mode is normal

B2_45 = X8 $ Y8 $ (B2L2 # B2L3);


--B2L4 is 7483:inst1|2~69 at LC_X52_Y4_N2
--operation mode is normal

B2L4 = Y8 & !X8 & (B2L2 # B2L3) # !Y8 & (B2L2 # B2L3 # !X8);


--X1 is X1 at PIN_C15
--operation mode is input

X1 = INPUT();


