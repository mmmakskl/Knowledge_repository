--B1L4 is 7483:inst|27~1 at LC_X52_Y1_N4
--operation mode is normal

B1L4 = X1 $ Y1;


--B1L5 is 7483:inst|43~39 at LC_X52_Y1_N8
--operation mode is normal

B1L5 = X2 $ Y2 $ (X1 & Y1);


--B1L1 is 7483:inst|1~199 at LC_X52_Y1_N9
--operation mode is normal

B1L1 = X2 & !Y2 & (!Y1 # !X1) # !X2 & (!Y2 # !Y1 # !X1);


--B1_44 is 7483:inst|44 at LC_X52_Y1_N5
--operation mode is normal

B1_44 = Y3 $ X3 $ B1L1;


--B1L2 is 7483:inst|1~200 at LC_X52_Y1_N6
--operation mode is normal

B1L2 = Y3 & !X3 & B1L1 # !Y3 & (B1L1 # !X3);


--B1_45 is 7483:inst|45 at LC_X52_Y1_N2
--operation mode is normal

B1_45 = X4 $ (Y4 $ B1L2);


--B1L3 is 7483:inst|2~71 at LC_X52_Y1_N7
--operation mode is normal

B1L3 = X4 & (!Y4 & B1L2) # !X4 & (B1L2 # !Y4);


--X1 is X1 at PIN_Y2
--operation mode is input

X1 = INPUT();


--Y1 is Y1 at PIN_W2
--operation mode is input

Y1 = INPUT();


--Y2 is Y2 at PIN_Y3
--operation mode is input

Y2 = INPUT();


--X2 is X2 at PIN_W3
--operation mode is input

X2 = INPUT();


--Y3 is Y3 at PIN_V3
--operation mode is input

Y3 = INPUT();


--X3 is X3 at PIN_T7
--operation mode is input

X3 = INPUT();


--Y4 is Y4 at PIN_AA2
--operation mode is input

Y4 = INPUT();


--X4 is X4 at PIN_U5
--operation mode is input

X4 = INPUT();


--S1 is S1 at PIN_AA3
--operation mode is output

S1 = OUTPUT(B1L4);


--S2 is S2 at PIN_W4
--operation mode is output

S2 = OUTPUT(B1L5);


--S3 is S3 at PIN_T5
--operation mode is output

S3 = OUTPUT(!B1_44);


--S4 is S4 at PIN_W1
--operation mode is output

S4 = OUTPUT(!B1_45);


--C4 is C4 at PIN_V4
--operation mode is output

C4 = OUTPUT(!B1L3);



