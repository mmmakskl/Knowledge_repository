--B1L5 is 7483:inst5|42~39 at LC_X5_Y30_N5
--operation mode is normal

B1L5 = X0 $ Y0 $ (A0 & B0);


--B1L4 is 7483:inst5|18~82 at LC_X5_Y30_N7
--operation mode is normal

B1L4 = X0 & !Y0 & (!B0 # !A0) # !X0 & (!B0 # !A0 # !Y0);


--B1L6 is 7483:inst5|43~113 at LC_X5_Y30_N4
--operation mode is normal

B1L6 = X1 $ B1L4 $ (A1 & B0);


--B2_42 is 7483:inst6|42 at LC_X5_Y30_N2
--operation mode is normal

B2_42 = Y1 $ B1L6 $ (B1 & A0);


--inst14 is inst14 at LC_X6_Y30_N2
--operation mode is normal

inst14 = A2 & (B0);


--A1L61 is inst15~31 at LC_X5_Y30_N8
--operation mode is normal

A1L61 = !X1 & (!B0 # !A1);


--B1_44 is 7483:inst5|44 at LC_X6_Y30_N4
--operation mode is normal

B1_44 = X2 $ inst14 $ (B1L01 # A1L61);


--B2L8 is 7483:inst6|51~173 at LC_X5_Y30_N6
--operation mode is normal

B2L8 = Y1 & B1L6 & (!A0 # !B1) # !Y1 & (B1L6 # !A0 # !B1);


--B2_43 is 7483:inst6|43 at LC_X3_Y30_N4
--operation mode is normal

B2_43 = B2L8 $ B1_44 $ (A1 & B1);


--B1L1 is 7483:inst5|1~248 at LC_X5_Y30_N9
--operation mode is normal

B1L1 = inst14 & !X2 & (B1L2 # A1L61) # !inst14 & (B1L2 # A1L61 # !X2);


--B1_45 is 7483:inst5|45 at LC_X3_Y30_N1
--operation mode is normal

B1_45 = B1L1 $ X3 $ (A3 & B0);


--inst2 is inst2 at LC_X3_Y30_N9
--operation mode is normal

inst2 = B1 & A2;


--A1L41 is inst3~17 at LC_X3_Y30_N8
--operation mode is normal

A1L41 = B1_44 & (!B1 # !A1);


--B2L1 is 7483:inst6|1~43 at LC_X3_Y30_N2
--operation mode is normal

B2L1 = B2L8 & (B1_44 # !B1 # !A1);


--B2_44 is 7483:inst6|44 at LC_X3_Y30_N6
--operation mode is normal

B2_44 = inst2 $ B1_45 $ (A1L41 # B2L1);


--B1L3 is 7483:inst5|2~85 at LC_X3_Y30_N0
--operation mode is normal

B1L3 = B1L1 & (!B0 # !X3 # !A3) # !B1L1 & !X3 & (!B0 # !A3);


--B2L2 is 7483:inst6|1~44 at LC_X3_Y30_N3
--operation mode is normal

B2L2 = inst2 & B1_45 & (A1L41 # B2L1) # !inst2 & (A1L41 # B1_45 # B2L1);


--B2L3 is 7483:inst6|2~69 at LC_X3_Y30_N5
--operation mode is normal

B2L3 = B2L2 & (B1L3 # !B1 # !A3) # !B2L2 & B1L3 & (!B1 # !A3);


--B2_45 is 7483:inst6|45 at LC_X3_Y30_N7
--operation mode is normal

B2_45 = B2L2 $ B1L3 $ (!B1 # !A3);


--B1L2 is 7483:inst5|1~249 at LC_X5_Y30_N3
--operation mode is normal

B1L2 = B1L4 & (!B0 # !X1 # !A1);


--B1L9 is 7483:inst5|51~155 at LC_X5_Y30_N1
--operation mode is normal

B1L9 = X0 & !Y0 & (!B0 # !A0) # !X0 & (!B0 # !A0 # !Y0);


--B1L01 is 7483:inst5|51~156 at LC_X5_Y30_N0
--operation mode is normal

B1L01 = B1L9 & (!B0 # !X1 # !A1);


