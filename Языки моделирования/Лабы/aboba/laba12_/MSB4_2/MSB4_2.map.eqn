--B1L5 is 7483:inst5|42~39
--operation mode is normal

B1L5 = Y0 $ X0 $ (A0 & B0);


--B1L4 is 7483:inst5|18~82
--operation mode is normal

B1L4 = Y0 & !X0 & (!B0 # !A0) # !Y0 & (!X0 # !B0 # !A0);


--B1L6 is 7483:inst5|43~113
--operation mode is normal

B1L6 = B1L4 $ X1 $ (B0 & A1);


--B2_42 is 7483:inst6|42
--operation mode is normal

B2_42 = B1L6 $ Y1 $ (A0 & B1);


--inst14 is inst14
--operation mode is normal

inst14 = B0 & A2;


--A1L61 is inst15~31
--operation mode is normal

A1L61 = !X1 & (!A1 # !B0);


--B1_44 is 7483:inst5|44
--operation mode is normal

B1_44 = inst14 $ X2 $ (B1L01 # A1L61);


--B2L8 is 7483:inst6|51~173
--operation mode is normal

B2L8 = B1L6 & (!Y1 # !B1 # !A0) # !B1L6 & !Y1 & (!B1 # !A0);


--B2_43 is 7483:inst6|43
--operation mode is normal

B2_43 = B1_44 $ B2L8 $ (A1 & B1);


--B1L1 is 7483:inst5|1~248
--operation mode is normal

B1L1 = inst14 & !X2 & (A1L61 # B1L2) # !inst14 & (A1L61 # B1L2 # !X2);


--B1_45 is 7483:inst5|45
--operation mode is normal

B1_45 = B1L1 $ X3 $ (B0 & A3);


--inst2 is inst2
--operation mode is normal

inst2 = B1 & A2;


--A1L41 is inst3~17
--operation mode is normal

A1L41 = B1_44 & (!B1 # !A1);


--B2L1 is 7483:inst6|1~43
--operation mode is normal

B2L1 = B2L8 & (B1_44 # !B1 # !A1);


--B2_44 is 7483:inst6|44
--operation mode is normal

B2_44 = B1_45 $ inst2 $ (A1L41 # B2L1);


--B1L3 is 7483:inst5|2~85
--operation mode is normal

B1L3 = B1L1 & (!X3 # !A3 # !B0) # !B1L1 & !X3 & (!A3 # !B0);


--B2L2 is 7483:inst6|1~44
--operation mode is normal

B2L2 = B1_45 & (A1L41 # B2L1 # !inst2) # !B1_45 & !inst2 & (A1L41 # B2L1);


--B2L3 is 7483:inst6|2~69
--operation mode is normal

B2L3 = B1L3 & (B2L2 # !A3 # !B1) # !B1L3 & B2L2 & (!A3 # !B1);


--B2_45 is 7483:inst6|45
--operation mode is normal

B2_45 = B1L3 $ B2L2 $ (!A3 # !B1);


--B1L2 is 7483:inst5|1~249
--operation mode is normal

B1L2 = B1L4 & (!X1 # !A1 # !B0);


--B1L9 is 7483:inst5|51~155
--operation mode is normal

B1L9 = X0 & !Y0 & (!A0 # !B0) # !X0 & (!Y0 # !A0 # !B0);


--B1L01 is 7483:inst5|51~156
--operation mode is normal

B1L01 = B1L9 & (!A1 # !X1 # !B0);


--A0 is A0
--operation mode is input

A0 = INPUT();


--B0 is B0
--operation mode is input

B0 = INPUT();


--Y0 is Y0
--operation mode is input

Y0 = INPUT();


--X0 is X0
--operation mode is input

X0 = INPUT();


--B1 is B1
--operation mode is input

B1 = INPUT();


--A1 is A1
--operation mode is input

A1 = INPUT();


--X1 is X1
--operation mode is input

X1 = INPUT();


--Y1 is Y1
--operation mode is input

Y1 = INPUT();


--A2 is A2
--operation mode is input

A2 = INPUT();


--X2 is X2
--operation mode is input

X2 = INPUT();


--A3 is A3
--operation mode is input

A3 = INPUT();


--X3 is X3
--operation mode is input

X3 = INPUT();


--C0 is C0
--operation mode is output

C0 = OUTPUT(B1L5);


--C1 is C1
--operation mode is output

C1 = OUTPUT(!B2_42);


--C2 is C2
--operation mode is output

C2 = OUTPUT(B2_43);


--C3 is C3
--operation mode is output

C3 = OUTPUT(B2_44);


--C5 is C5
--operation mode is output

C5 = OUTPUT(!B2L3);


--C4 is C4
--operation mode is output

C4 = OUTPUT(!B2_45);


