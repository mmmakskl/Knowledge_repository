--A1L3 is inst14~131 at LC_X5_Y1_N9
--operation mode is normal

A1L3 = X1 & Y1 & (Y0 # !X0) # !X1 & (Y0 # Y1 # !X0);


--A1L2 is inst10~34 at LC_X5_Y1_N8
--operation mode is normal

A1L2 = X1 & Y1 & (X0 $ !Y0) # !X1 & !Y1 & (X0 $ !Y0);


--A1L4 is inst14~132 at LC_X5_Y1_N2
--operation mode is normal

A1L4 = A1L3 & (!XGY0 # !A1L2);


--A1L5 is inst15~131 at LC_X5_Y1_N6
--operation mode is normal

A1L5 = X1 & (X0 # !Y1 # !Y0) # !X1 & !Y1 & (X0 # !Y0);


--A1L6 is inst15~132 at LC_X5_Y1_N5
--operation mode is normal

A1L6 = A1L5 & (!XLY0 # !A1L2);


--inst9 is inst9 at LC_X5_Y1_N4
--operation mode is normal

inst9 = XEY0 & (A1L2);


--Y1 is Y1 at PIN_V18
--operation mode is input

Y1 = INPUT();


--Y0 is Y0 at PIN_AB17
--operation mode is input

Y0 = INPUT();


--X0 is X0 at PIN_Y18
--operation mode is input

X0 = INPUT();


--X1 is X1 at PIN_AA19
--operation mode is input

X1 = INPUT();


--XGY0 is XGY0 at PIN_Y17
--operation mode is input

XGY0 = INPUT();


--XLY0 is XLY0 at PIN_AB18
--operation mode is input

XLY0 = INPUT();


--XEY0 is XEY0 at PIN_Y16
--operation mode is input

XEY0 = INPUT();


--XGY is XGY at PIN_AB19
--operation mode is output

XGY = OUTPUT(!A1L4);


--XLY is XLY at PIN_W17
--operation mode is output

XLY = OUTPUT(!A1L6);


--XEY is XEY at PIN_V17
--operation mode is output

XEY = OUTPUT(inst9);



