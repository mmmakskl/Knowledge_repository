--B2L1 is cmp_p:cmp_2|gr~3
--operation mode is normal

B2L1 = x[3] & (x[2] & !y[2] # !y[3]) # !x[3] & x[2] & !y[2] & !y[3];


--B2L2 is cmp_p:cmp_2|xey~75
--operation mode is normal

B2L2 = x[3] & y[3] & (x[2] $ !y[2]) # !x[3] & !y[3] & (x[2] $ !y[2]);


--B1L1 is cmp_p:cmp_1|gr~3
--operation mode is normal

B1L1 = x[1] & (x[0] & !y[0] # !y[1]) # !x[1] & x[0] & !y[0] & !y[1];


--B2L3 is cmp_p:cmp_2|xey~76
--operation mode is normal

B2L3 = x[1] & y[1] & (x[0] $ !y[0]) # !x[1] & !y[1] & (x[0] $ !y[0]);


--B2L5 is cmp_p:cmp_2|xgy~68
--operation mode is normal

B2L5 = xgy0 & B2L3;


--B2L6 is cmp_p:cmp_2|xgy~69
--operation mode is normal

B2L6 = B2L1 # B2L2 & (B1L1 # B2L5);


--B2L7 is cmp_p:cmp_2|xly~317
--operation mode is normal

B2L7 = B2L3 & xly0 # !B2L3 & (!B1L1);


--B2L8 is cmp_p:cmp_2|xly~318
--operation mode is normal

B2L8 = B2L2 & B2L7 # !B2L2 & (!B2L1);


--B2L4 is cmp_p:cmp_2|xey~77
--operation mode is normal

B2L4 = B2L3 & B2L2 & xey0;


--x[3] is x[3]
--operation mode is input

x[3] = INPUT();


--x[2] is x[2]
--operation mode is input

x[2] = INPUT();


--y[2] is y[2]
--operation mode is input

y[2] = INPUT();


--y[3] is y[3]
--operation mode is input

y[3] = INPUT();


--x[1] is x[1]
--operation mode is input

x[1] = INPUT();


--x[0] is x[0]
--operation mode is input

x[0] = INPUT();


--y[0] is y[0]
--operation mode is input

y[0] = INPUT();


--y[1] is y[1]
--operation mode is input

y[1] = INPUT();


--xgy0 is xgy0
--operation mode is input

xgy0 = INPUT();


--xly0 is xly0
--operation mode is input

xly0 = INPUT();


--xey0 is xey0
--operation mode is input

xey0 = INPUT();


--xgy is xgy
--operation mode is output

xgy = OUTPUT(B2L6);


--xly is xly
--operation mode is output

xly = OUTPUT(B2L8);


--xey is xey
--operation mode is output

xey = OUTPUT(B2L4);


