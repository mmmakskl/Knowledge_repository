--B1L8 is cmp_g:inst|inst14~18
--operation mode is normal

B1L8 = Y3 & (Y2 # !X3 # !X2) # !Y3 & !X3 & (Y2 # !X2);


--B1L3 is cmp_g:inst|inst9~73
--operation mode is normal

B1L3 = Y1 & X1 & (Y0 $ !X0) # !Y1 & !X1 & (Y0 $ !X0);


--B1L6 is cmp_g:inst|inst10~158
--operation mode is normal

B1L6 = XGY0 & B1L3;


--B1L7 is cmp_g:inst|inst10~159
--operation mode is normal

B1L7 = X1 & (X0 & !Y0 # !Y1) # !X1 & X0 & !Y0 & !Y1;


--B1L4 is cmp_g:inst|inst9~74
--operation mode is normal

B1L4 = Y3 & X3 & (X2 $ !Y2) # !Y3 & !X3 & (X2 $ !Y2);


--B1L9 is cmp_g:inst|inst14~19
--operation mode is normal

B1L9 = B1L8 & (!B1L6 & !B1L7 # !B1L4);


--B1L01 is cmp_g:inst|inst15~18
--operation mode is normal

B1L01 = X3 & (X2 # !Y3 # !Y2) # !X3 & !Y3 & (X2 # !Y2);


--B1L1 is cmp_g:inst|inst8~158
--operation mode is normal

B1L1 = B1L3 & XLY0;


--B1L2 is cmp_g:inst|inst8~159
--operation mode is normal

B1L2 = Y1 & (Y0 & !X0 # !X1) # !Y1 & Y0 & !X0 & !X1;


--B1L11 is cmp_g:inst|inst15~19
--operation mode is normal

B1L11 = B1L01 & (!B1L1 & !B1L2 # !B1L4);


--B1L5 is cmp_g:inst|inst9~75
--operation mode is normal

B1L5 = B1L3 & B1L4 & XEY0;


--Y3 is Y3
--operation mode is input

Y3 = INPUT();


--Y2 is Y2
--operation mode is input

Y2 = INPUT();


--X2 is X2
--operation mode is input

X2 = INPUT();


--X3 is X3
--operation mode is input

X3 = INPUT();


--XGY0 is XGY0
--operation mode is input

XGY0 = INPUT();


--Y1 is Y1
--operation mode is input

Y1 = INPUT();


--Y0 is Y0
--operation mode is input

Y0 = INPUT();


--X0 is X0
--operation mode is input

X0 = INPUT();


--X1 is X1
--operation mode is input

X1 = INPUT();


--XLY0 is XLY0
--operation mode is input

XLY0 = INPUT();


--XEY0 is XEY0
--operation mode is input

XEY0 = INPUT();


--XGY is XGY
--operation mode is output

XGY = OUTPUT(!B1L9);


--XLY is XLY
--operation mode is output

XLY = OUTPUT(!B1L11);


--XEY is XEY
--operation mode is output

XEY = OUTPUT(B1L5);


