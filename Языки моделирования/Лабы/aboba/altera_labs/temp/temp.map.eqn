--B1_17 is norltch:inst5|17
--operation mode is normal

B1_17 = B1_16 # C;


--B1_16 is norltch:inst5|16
--operation mode is normal

B1_16 = !C & (B1_16);


--C is C
--operation mode is input

C = INPUT();


--Q is Q
--operation mode is output

Q = OUTPUT(!B1_16);


--Q2 is Q2
--operation mode is output

Q2 = OUTPUT(B1_17);


