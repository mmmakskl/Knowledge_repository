--B1_17 is norltch:inst5|17 at LC_X52_Y1_N2
--operation mode is normal

B1_17 = C # B1_16;


--B1_16 is norltch:inst5|16 at LC_X52_Y1_N4
--operation mode is normal

B1_16 = !C & B1_16;


--C is C at PIN_T7
--operation mode is input

C = INPUT();


--Q is Q at PIN_V4
--operation mode is output

Q = OUTPUT(!B1_16);


--Q2 is Q2 at PIN_Y3
--operation mode is output

Q2 = OUTPUT(B1_17);



