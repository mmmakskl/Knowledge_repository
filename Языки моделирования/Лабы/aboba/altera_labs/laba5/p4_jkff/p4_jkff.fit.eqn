--inst is inst at LC_X17_Y30_N2
--operation mode is normal

inst_lut_out = inst & !k # !inst & (j);
inst = DFFEAS(inst_lut_out, clk, VCC, , , , , , );


--j is j at PIN_E14
--operation mode is input

j = INPUT();


--k is k at PIN_F14
--operation mode is input

k = INPUT();


--clk is clk at PIN_D14
--operation mode is input

clk = INPUT();


--q is q at PIN_L16
--operation mode is output

q = OUTPUT(inst);



