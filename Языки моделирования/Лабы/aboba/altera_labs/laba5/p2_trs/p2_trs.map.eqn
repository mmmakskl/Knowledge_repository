--A1L1 is inst5~48
--operation mode is normal

A1L1 = S & !A1L2 & (!T # !A1L3);


--A1L3 is inst10~70
--operation mode is normal

A1L3 = T & (A1L3) # !T & !A1L2 & S;


--A1L2 is inst6~57
--operation mode is normal

A1L2 = R & !A1L1 & (A1L3 # !T);


--S is S
--operation mode is input

S = INPUT();


--T is T
--operation mode is input

T = INPUT();


--R is R
--operation mode is input

R = INPUT();


--Q is Q
--operation mode is output

Q = OUTPUT(!A1L1);


--Qi is Qi
--operation mode is output

Qi = OUTPUT(!A1L2);


