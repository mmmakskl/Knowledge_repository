--A1L2 is inst6~59 at LC_X52_Y1_N6
--operation mode is normal

A1L2 = A1L4 # !k;


--A1L1 is inst5~50 at LC_X52_Y1_N2
--operation mode is normal

A1L1 = s & !A1L3 & (!A1L2 # !j);


--A1L4 is inst10~68 at LC_X52_Y1_N5
--operation mode is normal

A1L4 = k & (A1L4) # !k & A1L1 & (A1L4 # !A1L3);


--A1L3 is inst6~60 at LC_X52_Y1_N4
--operation mode is normal

A1L3 = r & !A1L1 & (A1L4 # !k);


--s is s at PIN_AA3
--operation mode is input

s = INPUT();


--k is k at PIN_AA2
--operation mode is input

k = INPUT();


--j is j at PIN_W3
--operation mode is input

j = INPUT();


--r is r at PIN_V3
--operation mode is input

r = INPUT();


--q is q at PIN_Y3
--operation mode is output

q = OUTPUT(!A1L1);


--qi is qi at PIN_T7
--operation mode is output

qi = OUTPUT(!A1L3);



