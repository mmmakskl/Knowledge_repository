--A1L2 is inst6~59
--operation mode is normal

A1L2 = A1L4 # !k;


--A1L1 is inst5~50
--operation mode is normal

A1L1 = s & !A1L3 & (!j # !A1L2);


--A1L4 is inst10~68
--operation mode is normal

A1L4 = k & (A1L4) # !k & A1L1 & (A1L4 # !A1L3);


--A1L3 is inst6~60
--operation mode is normal

A1L3 = r & !A1L1 & (A1L4 # !k);


--s is s
--operation mode is input

s = INPUT();


--k is k
--operation mode is input

k = INPUT();


--j is j
--operation mode is input

j = INPUT();


--r is r
--operation mode is input

r = INPUT();


--q is q
--operation mode is output

q = OUTPUT(!A1L1);


--qi is qi
--operation mode is output

qi = OUTPUT(!A1L3);


