--A1L7Q is ex1~reg0
--operation mode is normal

A1L7Q_lut_out = d;
A1L7Q = DFFEAS(A1L7Q_lut_out, c1, VCC, , r, , , , );


--d31 is d31
--operation mode is normal

d31_lut_out = d21;
d31 = DFFEAS(d31_lut_out, c1, VCC, , r, , , , );


--d21 is d21
--operation mode is normal

d21_lut_out = A1L7Q;
d21 = DFFEAS(d21_lut_out, c2, VCC, , r, , , , );


--A1L11Q is q2~reg0
--operation mode is normal

A1L11Q_lut_out = d31;
A1L11Q = DFFEAS(A1L11Q_lut_out, c2, VCC, , r, , , , );


--d is d
--operation mode is input

d = INPUT();


--c1 is c1
--operation mode is input

c1 = INPUT();


--r is r
--operation mode is input

r = INPUT();


--c2 is c2
--operation mode is input

c2 = INPUT();


--ex1 is ex1
--operation mode is output

ex1 = OUTPUT(A1L7Q);


--ex2 is ex2
--operation mode is output

ex2 = OUTPUT(d31);


--q1 is q1
--operation mode is output

q1 = OUTPUT(d21);


--q2 is q2
--operation mode is output

q2 = OUTPUT(A1L11Q);


