--A1L7Q is ex1~reg0 at LC_X1_Y1_N6
--operation mode is normal

A1L7Q_lut_out = d;
A1L7Q = DFFEAS(A1L7Q_lut_out, GLOBAL(c1), VCC, , r, , , , );


--d31 is d31 at LC_X1_Y1_N2
--operation mode is normal

d31_lut_out = GND;
d31 = DFFEAS(d31_lut_out, GLOBAL(c1), VCC, , r, d21, , , VCC);


--d21 is d21 at LC_X1_Y1_N5
--operation mode is normal

d21_lut_out = A1L7Q;
d21 = DFFEAS(d21_lut_out, GLOBAL(c2), VCC, , r, , , , );


--A1L11Q is q2~reg0 at LC_X1_Y1_N4
--operation mode is normal

A1L11Q_lut_out = d31;
A1L11Q = DFFEAS(A1L11Q_lut_out, GLOBAL(c2), VCC, , r, , , , );


--d is d at PIN_AA20
--operation mode is input

d = INPUT();


--c1 is c1 at PIN_L2
--operation mode is input

c1 = INPUT();


--r is r at PIN_U19
--operation mode is input

r = INPUT();


--c2 is c2 at PIN_L3
--operation mode is input

c2 = INPUT();


--ex1 is ex1 at PIN_Y20
--operation mode is output

ex1 = OUTPUT(A1L7Q);


--ex2 is ex2 at PIN_Y21
--operation mode is output

ex2 = OUTPUT(d31);


--q1 is q1 at PIN_AA21
--operation mode is output

q1 = OUTPUT(d21);


--q2 is q2 at PIN_U20
--operation mode is output

q2 = OUTPUT(A1L11Q);



