--A1L2 is inst~39
--operation mode is normal

A1L2 = x2 # x7 # x0 # x4;


--A1L3 is inst~40
--operation mode is normal

A1L3 = x3 # x5;


--inst is inst
--operation mode is normal

inst = A1L2 # A1L3 # x6 # x1;


--x2 is x2
--operation mode is input

x2 = INPUT();


--x7 is x7
--operation mode is input

x7 = INPUT();


--x0 is x0
--operation mode is input

x0 = INPUT();


--x4 is x4
--operation mode is input

x4 = INPUT();


--x3 is x3
--operation mode is input

x3 = INPUT();


--x5 is x5
--operation mode is input

x5 = INPUT();


--x6 is x6
--operation mode is input

x6 = INPUT();


--x1 is x1
--operation mode is input

x1 = INPUT();


--q is q
--operation mode is output

q = OUTPUT(inst);


