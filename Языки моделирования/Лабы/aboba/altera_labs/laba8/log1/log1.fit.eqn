--B1L1 is mux4_1gr:inst|inst4~1 at LC_X52_Y1_N2
--operation mode is normal

B1L1 = b $ a;


--a is a at PIN_V4
--operation mode is input

a = INPUT();


--b is b at PIN_W4
--operation mode is input

b = INPUT();


--f is f at PIN_W3
--operation mode is output

f = OUTPUT(B1L1);



