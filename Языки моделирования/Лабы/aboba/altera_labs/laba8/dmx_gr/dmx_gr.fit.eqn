--inst1 is inst1 at LC_X7_Y1_N6
--operation mode is normal

inst1 = !x0 & e & !x1;


--inst2 is inst2 at LC_X7_Y1_N4
--operation mode is normal

inst2 = x0 & e & !x1;


--inst3 is inst3 at LC_X7_Y1_N5
--operation mode is normal

inst3 = !x0 & e & x1;


--inst4 is inst4 at LC_X7_Y1_N2
--operation mode is normal

inst4 = x0 & e & x1;


--e is e at PIN_V18
--operation mode is input

e = INPUT();


--x0 is x0 at PIN_V17
--operation mode is input

x0 = INPUT();


--x1 is x1 at PIN_Y16
--operation mode is input

x1 = INPUT();


--F0 is F0 at PIN_U16
--operation mode is output

F0 = OUTPUT(inst1);


--F1 is F1 at PIN_T16
--operation mode is output

F1 = OUTPUT(inst2);


--F2 is F2 at PIN_V16
--operation mode is output

F2 = OUTPUT(inst3);


--F3 is F3 at PIN_U17
--operation mode is output

F3 = OUTPUT(inst4);



