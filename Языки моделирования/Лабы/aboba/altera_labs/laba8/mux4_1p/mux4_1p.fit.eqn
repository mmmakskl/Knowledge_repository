--A1L5 is process0~13 at LC_X52_Y1_N2
--operation mode is normal

A1L5 = a[1] & (a[0] # x[2]) # !a[1] & x[0] & !a[0];


--A1L6 is process0~14 at LC_X52_Y1_N5
--operation mode is normal

A1L6 = A1L5 & (x[3] # !a[0]) # !A1L5 & (a[0] & x[1]);


--t is t at LC_X52_Y1_N4
--operation mode is normal

t = A1L6 & en;


--x[1] is x[1] at PIN_W4
--operation mode is input

x[1] = INPUT();


--a[0] is a[0] at PIN_AA2
--operation mode is input

a[0] = INPUT();


--x[2] is x[2] at PIN_AA3
--operation mode is input

x[2] = INPUT();


--a[1] is a[1] at PIN_Y3
--operation mode is input

a[1] = INPUT();


--x[0] is x[0] at PIN_T7
--operation mode is input

x[0] = INPUT();


--x[3] is x[3] at PIN_W3
--operation mode is input

x[3] = INPUT();


--en is en at PIN_V3
--operation mode is input

en = INPUT();


--q is q at PIN_V4
--operation mode is output

q = OUTPUT(t);



