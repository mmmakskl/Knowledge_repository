--A1L5 is process0~13
--operation mode is normal

A1L5 = a[0] & (a[1]) # !a[0] & (a[1] & x[2] # !a[1] & (x[0]));


--A1L6 is process0~14
--operation mode is normal

A1L6 = a[0] & (A1L5 & (x[3]) # !A1L5 & x[1]) # !a[0] & (A1L5);


--t is t
--operation mode is normal

t = A1L6 & en;


--x[1] is x[1]
--operation mode is input

x[1] = INPUT();


--a[0] is a[0]
--operation mode is input

a[0] = INPUT();


--x[2] is x[2]
--operation mode is input

x[2] = INPUT();


--a[1] is a[1]
--operation mode is input

a[1] = INPUT();


--x[0] is x[0]
--operation mode is input

x[0] = INPUT();


--x[3] is x[3]
--operation mode is input

x[3] = INPUT();


--en is en
--operation mode is input

en = INPUT();


--q is q
--operation mode is output

q = OUTPUT(t);


