--inst1 is inst1
--operation mode is normal

inst1 = ENB # a0 # a1 # a2;


--inst12 is inst12
--operation mode is normal

inst12 = ENB # a1 # a2 # !a0;


--inst13 is inst13
--operation mode is normal

inst13 = ENB # a0 # a2 # !a1;


--inst14 is inst14
--operation mode is normal

inst14 = ENB # a2 # !a1 # !a0;


--inst15 is inst15
--operation mode is normal

inst15 = ENB # a0 # a1 # !a2;


--inst16 is inst16
--operation mode is normal

inst16 = ENB # a1 # !a2 # !a0;


--inst17 is inst17
--operation mode is normal

inst17 = ENB # a0 # !a2 # !a1;


--inst18 is inst18
--operation mode is normal

inst18 = ENB # !a2 # !a1 # !a0;


--ENB is ENB
--operation mode is input

ENB = INPUT();


--a0 is a0
--operation mode is input

a0 = INPUT();


--a1 is a1
--operation mode is input

a1 = INPUT();


--a2 is a2
--operation mode is input

a2 = INPUT();


--q0 is q0
--operation mode is output

q0 = OUTPUT(inst1);


--q1 is q1
--operation mode is output

q1 = OUTPUT(inst12);


--q2 is q2
--operation mode is output

q2 = OUTPUT(inst13);


--q3 is q3
--operation mode is output

q3 = OUTPUT(inst14);


--q4 is q4
--operation mode is output

q4 = OUTPUT(inst15);


--q5 is q5
--operation mode is output

q5 = OUTPUT(inst16);


--q6 is q6
--operation mode is output

q6 = OUTPUT(inst17);


--q7 is q7
--operation mode is output

q7 = OUTPUT(inst18);


