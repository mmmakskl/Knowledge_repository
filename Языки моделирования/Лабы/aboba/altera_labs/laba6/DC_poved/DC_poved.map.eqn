--A1L2 is p0~26
--operation mode is normal

A1L2 = x2 # x1 # x0 # ENB;


--A1L3 is p1~16
--operation mode is normal

A1L3 = x0 & !x2 & !x1 & !ENB;


--A1L4 is p2~19
--operation mode is normal

A1L4 = x2 # x0 # ENB # !x1;


--A1L5 is p3~17
--operation mode is normal

A1L5 = x1 & x0 & !x2 & !ENB;


--A1L6 is p4~25
--operation mode is normal

A1L6 = x1 # x0 # ENB # !x2;


--A1L7 is p5~16
--operation mode is normal

A1L7 = x2 & x0 & !x1 & !ENB;


--A1L8 is p6~16
--operation mode is normal

A1L8 = x0 # ENB # !x1 # !x2;


--A1L9 is p7~13
--operation mode is normal

A1L9 = x2 & x1 & x0 & !ENB;


--x2 is x2
--operation mode is input

x2 = INPUT();


--x1 is x1
--operation mode is input

x1 = INPUT();


--x0 is x0
--operation mode is input

x0 = INPUT();


--ENB is ENB
--operation mode is input

ENB = INPUT();


--q0 is q0
--operation mode is output

q0 = OUTPUT(!A1L2);


--q1 is q1
--operation mode is output

q1 = OUTPUT(A1L3);


--q2 is q2
--operation mode is output

q2 = OUTPUT(!A1L4);


--q3 is q3
--operation mode is output

q3 = OUTPUT(A1L5);


--q4 is q4
--operation mode is output

q4 = OUTPUT(!A1L6);


--q5 is q5
--operation mode is output

q5 = OUTPUT(A1L7);


--q6 is q6
--operation mode is output

q6 = OUTPUT(!A1L8);


--q7 is q7
--operation mode is output

q7 = OUTPUT(A1L9);


