** EQUATIONS **

read     : INPUT;
reset    : INPUT;
write    : INPUT;
X1       : INPUT;
X2       : INPUT;
X3       : INPUT;
X4       : INPUT;

-- Node name is 'Q1_' = ':1' 
-- Equation name is 'Q1_', type is output 
 Q1_     = DFFE( X1 $  GND, GLOBAL( write), GLOBAL( reset),  VCC,  VCC);

-- Node name is 'Q1' 
-- Equation name is 'Q1', location is LC022, type is output.
 Q1      = LCELL( _EQ001 $  GND);
  _EQ001 =  Q1_ &  read;

-- Node name is 'Q2_' = ':2' 
-- Equation name is 'Q2_', type is output 
 Q2_     = DFFE( X2 $  GND, GLOBAL( write), GLOBAL( reset),  VCC,  VCC);

-- Node name is 'Q2' 
-- Equation name is 'Q2', location is LC024, type is output.
 Q2      = LCELL( _EQ002 $  GND);
  _EQ002 =  Q2_ &  read;

-- Node name is 'Q3_' = ':9' 
-- Equation name is 'Q3_', type is output 
 Q3_     = DFFE( X3 $  GND, GLOBAL( write), GLOBAL( reset),  VCC,  VCC);

-- Node name is 'Q3' 
-- Equation name is 'Q3', location is LC021, type is output.
 Q3      = LCELL( _EQ003 $  GND);
  _EQ003 =  Q3_ &  read;

-- Node name is 'Q4_' = ':11' 
-- Equation name is 'Q4_', type is output 
 Q4_     = DFFE( X4 $  GND, GLOBAL( write), GLOBAL( reset),  VCC,  VCC);

-- Node name is 'Q4' 
-- Equation name is 'Q4', location is LC023, type is output.
