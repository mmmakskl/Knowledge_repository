--inst1 is inst1
--operation mode is normal

inst1 = e & (!x0 & !x1);


--inst2 is inst2
--operation mode is normal

inst2 = x0 & e & (!x1);


--inst3 is inst3
--operation mode is normal

inst3 = x1 & e & (!x0);


--inst4 is inst4
--operation mode is normal

inst4 = x0 & x1 & e;


--e is e
--operation mode is input

e = INPUT();


--x0 is x0
--operation mode is input

x0 = INPUT();


--x1 is x1
--operation mode is input

x1 = INPUT();


--F0 is F0
--operation mode is output

F0 = OUTPUT(inst1);


--F1 is F1
--operation mode is output

F1 = OUTPUT(inst2);


--F2 is F2
--operation mode is output

F2 = OUTPUT(inst3);


--F3 is F3
--operation mode is output

F3 = OUTPUT(inst4);


