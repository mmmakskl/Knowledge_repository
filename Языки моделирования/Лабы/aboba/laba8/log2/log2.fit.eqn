--B1L1 is mux4_1gr:inst|inst4~58 at LC_X1_Y1_N2
--operation mode is normal

B1L1 = c & !b & !a # !c & (!a # !b);


--a is a at PIN_W19
--operation mode is input

a = INPUT();


--b is b at PIN_Y20
--operation mode is input

b = INPUT();


--c is c at PIN_AA20
--operation mode is input

c = INPUT();


--F is F at PIN_W20
--operation mode is output

F = OUTPUT(!B1L1);



