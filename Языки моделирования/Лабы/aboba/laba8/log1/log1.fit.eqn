--B1_inst4 is mux4_1gr:inst|inst4 at LC_X1_Y1_N2
--operation mode is normal

B1_inst4 = b & !a & c # !b & a;


--c is c at PIN_W19
--operation mode is input

c = INPUT();


--a is a at PIN_Y20
--operation mode is input

a = INPUT();


--b is b at PIN_AA20
--operation mode is input

b = INPUT();


--f is f at PIN_W20
--operation mode is output

f = OUTPUT(B1_inst4);



