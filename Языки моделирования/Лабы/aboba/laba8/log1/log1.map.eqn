--B1_inst4 is mux4_1gr:inst|inst4
--operation mode is normal

B1_inst4 = a & (!b) # !a & c & b;


--c is c
--operation mode is input

c = INPUT();


--a is a
--operation mode is input

a = INPUT();


--b is b
--operation mode is input

b = INPUT();


--f is f
--operation mode is output

f = OUTPUT(B1_inst4);


